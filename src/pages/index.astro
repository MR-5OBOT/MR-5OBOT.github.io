---
// v6 home — retro-pc3 GLB (517KB, used as-is, no compression),
// rendered like the Sketchfab viewer: free drag-orbit, pan, zoom. Nothing else.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MR5OBOT</title>
    <meta name="description" content="OHLC trader and token burner." />
    <link rel="icon" type="image/png" href="/assets/profile-2.png" />
    <style>
      html, body { margin: 0; height: 100%; background: #3a3a3a; overflow: hidden; }
      canvas { display: block; }
      #loading {
        position: fixed; inset: 0; display: grid; place-items: center;
        background: #3a3a3a; z-index: 10;
        font: 11px/1.4 ui-monospace, 'Cascadia Mono', Menlo, Consolas, monospace;
        transition: opacity 0.6s ease;
      }
      #loading.done { opacity: 0; pointer-events: none; }
      #loading .box { display: grid; gap: 12px; justify-items: center; }
      #loading .name { color: #e8e8e8; letter-spacing: 0.5em; text-indent: 0.5em; font-size: 12px; }
      #load-track { width: 220px; height: 2px; background: rgba(255, 255, 255, 0.15); }
      #load-bar { width: 0%; height: 100%; background: #e8e8e8; transition: width 0.2s ease-out; }
      #load-pct { color: #999; letter-spacing: 0.2em; }
    </style>
  </head>
  <body>
    <div id="loading">
      <div class="box">
        <div class="name">MR5OBOT</div>
        <div id="load-track"><div id="load-bar"></div></div>
        <div id="load-pct">0%</div>
      </div>
    </div>

    <script type="module" is:inline>
      import * as THREE from 'https://esm.sh/three@0.163.0';
      import { OrbitControls } from 'https://esm.sh/three@0.163.0/examples/jsm/controls/OrbitControls.js';
      import { GLTFLoader } from 'https://esm.sh/three@0.163.0/examples/jsm/loaders/GLTFLoader.js';

      // if anything crashes, drop the loading overlay instead of freezing on it
      for (const ev of ['error', 'unhandledrejection'])
        addEventListener(ev, () => document.getElementById('loading')?.remove());

      const deg = (d) => d * (Math.PI / 180);

      // no baked background — the GLB has none; transparent canvas over the page
      const scene = new THREE.Scene();

      const camera = new THREE.PerspectiveCamera(45, innerWidth / innerHeight, 0.01, 100);

      const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
      renderer.setSize(innerWidth, innerHeight);
      renderer.toneMapping = THREE.NoToneMapping; // f3d-style raw colors, no filmic desat
      document.body.appendChild(renderer.domElement);

      // f3d-style neutral look: flat ambient + one white key light, no env map,
      // no tone mapping — raw texture colors. URL knobs for tuning without edits:
      //   ?amb  ambient fill   ?key  key strength   ?exp  exposure
      const P = new URLSearchParams(location.search);
      const knob = (k, d) => +(P.get(k) ?? d);
      renderer.toneMappingExposure = knob('exp', 1);
      scene.add(new THREE.AmbientLight(0xffffff, knob('amb', 0.7)));
      const key = new THREE.DirectionalLight(0xffffff, knob('key', 0.9));
      scene.add(key, key.target);

      const loadBar = document.getElementById('load-bar');
      const loadPct = document.getElementById('load-pct');
      function setProgress(p) { // p 0..1
        const pct = Math.min(100, Math.round(p * 100));
        loadBar.style.width = pct + '%';
        loadPct.textContent = pct + '%';
      }

      const gltf = await new Promise((res, rej) =>
        new GLTFLoader().load(
          '/assets/retro-pc3.glb',
          res,
          (e) => e.total && setProgress((e.loaded / e.total) * 0.9), // download = 0–90%
          rej
        )
      );
      scene.add(gltf.scene);

      // sharpen textures at grazing angles
      const maxAniso = renderer.capabilities.getMaxAnisotropy();
      gltf.scene.traverse((o) => {
        if (!o.isMesh) return;
        for (const k of ['map', 'aoMap', 'normalMap', 'roughnessMap', 'metalnessMap', 'emissiveMap'])
          if (o.material[k]) o.material[k].anisotropy = maxAniso;
      });

      // frame the whole scene head-on, camera slightly above center (screenshot view)
      const box = new THREE.Box3().setFromObject(gltf.scene);
      const center = box.getCenter(new THREE.Vector3());
      const size = box.getSize(new THREE.Vector3());
      const maxDim = Math.max(size.x, size.y, size.z);
      const dist = (maxDim / 2) / Math.tan(deg(camera.fov) / 2) * 1.0;

      // near/far scale with the model — this GLB is ~200 units wide, a fixed
      // far plane clips it entirely
      camera.near = maxDim / 100;
      camera.far = maxDim * 10;
      camera.updateProjectionMatrix();

      // key light aims at the scene from upper front-left, like the ref's desk-lamp mood
      key.position.set(center.x - maxDim * 0.8, center.y + maxDim * 1.2, center.z + maxDim * 1.4);
      key.target.position.copy(center);

      const controls = new OrbitControls(camera, renderer.domElement);
      controls.target.copy(center);
      controls.enableDamping = true;
      controls.dampingFactor = 0.06;
      controls.minDistance = maxDim * 0.25;
      controls.maxDistance = maxDim * 1.49; // max zoom-out = the chosen framing, scene never gets tiny

      // launch view (?az / ?pol / ?r override): az = horizontal angle, 0 is
      // head-on at the desk front; pol = vertical, <90 looks slightly down; r = distance
      const sph = new THREE.Spherical(
        maxDim * knob('r', 1.074),
        deg(knob('pol', 63.0)),
        deg(knob('az', -4.1))
      );
      camera.position.copy(controls.target).add(new THREE.Vector3().setFromSpherical(sph));
      controls.update();

      // dragging/zooming writes the current view into the address bar, so any
      // view can be copied as a URL and baked as the new default
      controls.addEventListener('end', () => {
        const s = new THREE.Spherical().setFromVector3(camera.position.clone().sub(controls.target));
        const q = new URLSearchParams(location.search);
        q.set('az', THREE.MathUtils.radToDeg(s.theta).toFixed(1));
        q.set('pol', THREE.MathUtils.radToDeg(s.phi).toFixed(1));
        q.set('r', (s.radius / maxDim).toFixed(3));
        history.replaceState(null, '', '?' + q);
      });

      renderer.setAnimationLoop(() => {
        controls.update(); // damping = smooth glide after drag
        renderer.render(scene, camera);
      });

      addEventListener('resize', () => {
        camera.aspect = innerWidth / innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(innerWidth, innerHeight);
      });

      setProgress(1);
      const loading = document.getElementById('loading');
      requestAnimationFrame(() => loading.classList.add('done'));
      loading.addEventListener('transitionend', () => loading.remove(), { once: true });
    </script>
  </body>
</html>
