---
// v6 home — retro-pc3 GLB (517KB, used as-is, no compression),
// rendered like the Sketchfab viewer: free drag-orbit, pan, zoom. Nothing else.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MR5OBOT</title>
    <meta name="description" content="OHLC trader and token burner." />
    <link rel="icon" type="image/png" href="/assets/profile-2.png" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@700&display=swap" />
    <style>
      html, body { margin: 0; height: 100%; background: #3a3a3a; overflow: hidden; }
      canvas { display: block; }
      #loading {
        position: fixed; inset: 0; display: grid; place-items: center;
        background: #3a3a3a; z-index: 10;
        font: 11px/1.4 ui-monospace, 'Cascadia Mono', Menlo, Consolas, monospace;
        transition: opacity 0.6s ease;
      }
      #loading.done { opacity: 0; pointer-events: none; }
      #loading .box { display: grid; gap: 12px; justify-items: center; }
      #loading .name { color: #e8e8e8; letter-spacing: 0.5em; text-indent: 0.5em; font-size: 12px; }
      #load-track { width: 220px; height: 2px; background: rgba(255, 255, 255, 0.15); }
      #load-bar { width: 0%; height: 100%; background: #e8e8e8; transition: width 0.2s ease-out; }
      #load-pct { color: #999; letter-spacing: 0.2em; }
      #back {
        position: fixed; top: 14px; left: 18px; z-index: 5;
        font: 56px ui-monospace, 'Cascadia Mono', Menlo, Consolas, monospace;
        line-height: 1; color: #7dff9f;
        text-shadow: 0 0 14px #7dff9f, 0 0 30px #7dff9f; /* same glow as the scene arrows */
        background: none; border: none; padding: 6px 12px; cursor: pointer;
        opacity: 0; pointer-events: none; transition: opacity 0.4s ease;
      }
      #back.on span { display: inline-block; animation: back-bob 0.84s ease-in-out infinite; }
      @keyframes back-bob { 50% { transform: translateX(-9px); } } /* same beat as the 3D arrows' bounce */
      #back.on { opacity: 1; pointer-events: auto; }
    </style>
  </head>
  <body>
    <div id="loading">
      <div class="box">
        <div class="name">MR5OBOT</div>
        <div id="load-track"><div id="load-bar"></div></div>
        <div id="load-pct">0%</div>
      </div>
    </div>
    <button id="back" aria-label="Back"><span>&larr;</span></button>

    <script type="module" is:inline>
      import * as THREE from 'https://esm.sh/three@0.163.0';
      import { OrbitControls } from 'https://esm.sh/three@0.163.0/examples/jsm/controls/OrbitControls.js';
      import { GLTFLoader } from 'https://esm.sh/three@0.163.0/examples/jsm/loaders/GLTFLoader.js';

      // if anything crashes, drop the loading overlay instead of freezing on it
      for (const ev of ['error', 'unhandledrejection'])
        addEventListener(ev, () => document.getElementById('loading')?.remove());

      const deg = (d) => d * (Math.PI / 180);

      // no baked background — the GLB has none; transparent canvas over the page
      const scene = new THREE.Scene();

      const camera = new THREE.PerspectiveCamera(45, innerWidth / innerHeight, 0.01, 100);

      const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
      renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
      renderer.setSize(innerWidth, innerHeight);
      renderer.toneMapping = THREE.NoToneMapping; // f3d-style raw colors, no filmic desat
      document.body.appendChild(renderer.domElement);

      // f3d-style neutral look: flat ambient + one white key light, no env map,
      // no tone mapping — raw texture colors. URL knobs for tuning without edits:
      //   ?amb  ambient fill   ?key  key strength   ?exp  exposure
      const P = new URLSearchParams(location.search);
      const knob = (k, d) => +(P.get(k) ?? d);
      renderer.toneMappingExposure = knob('exp', 1);
      scene.add(new THREE.AmbientLight(0xffffff, knob('amb', 0.7)));
      const key = new THREE.DirectionalLight(0xffffff, knob('key', 0.9));
      scene.add(key, key.target);

      const loadBar = document.getElementById('load-bar');
      const loadPct = document.getElementById('load-pct');
      function setProgress(p) { // p 0..1
        const pct = Math.min(100, Math.round(p * 100));
        loadBar.style.width = pct + '%';
        loadPct.textContent = pct + '%';
      }

      const gltf = await new Promise((res, rej) =>
        new GLTFLoader().load(
          '/assets/retro-pc3.glb',
          res,
          (e) => e.total && setProgress((e.loaded / e.total) * 0.9), // download = 0–90%
          rej
        )
      );
      scene.add(gltf.scene);

      // sharpen textures at grazing angles
      const maxAniso = renderer.capabilities.getMaxAnisotropy();
      gltf.scene.traverse((o) => {
        if (!o.isMesh) return;
        for (const k of ['map', 'aoMap', 'normalMap', 'roughnessMap', 'metalnessMap', 'emissiveMap'])
          if (o.material[k]) o.material[k].anisotropy = maxAniso;
      });

      // frame the whole scene head-on, camera slightly above center (screenshot view)
      const box = new THREE.Box3().setFromObject(gltf.scene);
      const center = box.getCenter(new THREE.Vector3());
      const size = box.getSize(new THREE.Vector3());
      const maxDim = Math.max(size.x, size.y, size.z);
      const dist = (maxDim / 2) / Math.tan(deg(camera.fov) / 2) * 1.0;

      // near/far scale with the model — this GLB is ~200 units wide, a fixed
      // far plane clips it entirely
      camera.near = maxDim / 100;
      camera.far = maxDim * 10;
      camera.updateProjectionMatrix();

      // round pedestal base under the scene, a shade darker than the bg
      const baseR = Math.hypot(size.x, size.z) / 2;
      const baseH = maxDim * 0.02;
      const base = new THREE.Mesh(
        new THREE.CylinderGeometry(baseR, baseR, baseH, 64),
        new THREE.MeshBasicMaterial({ color: 0x2f2f2f }) // flat, unlit — clean disc
      );
      // nudge toward the desk: box center leans to the chair side
      base.position.set(center.x, box.min.y - baseH / 2, center.z - size.z * 0.12);
      scene.add(base);

      // key light aims at the scene from upper front-left, like the ref's desk-lamp mood
      key.position.set(center.x - maxDim * 0.8, center.y + maxDim * 1.2, center.z + maxDim * 1.4);
      key.target.position.copy(center);

      const controls = new OrbitControls(camera, renderer.domElement);
      controls.target.copy(center);
      controls.enableDamping = true;
      controls.dampingFactor = 0.06;
      controls.minDistance = maxDim * 0.25;
      controls.maxDistance = maxDim * 1.49; // max zoom-out = the chosen framing, scene never gets tiny

      // launch view (?az / ?pol / ?r override): az = horizontal angle, 0 is
      // head-on at the desk front; pol = vertical, <90 looks slightly down; r = distance
      const sph = new THREE.Spherical(
        maxDim * knob('r', 1.074),
        deg(knob('pol', 63.0)),
        deg(knob('az', -4.1))
      );
      camera.position.copy(controls.target).add(new THREE.Vector3().setFromSpherical(sph));
      controls.update();

      // dragging/zooming writes the current view into the address bar, so any
      // view can be copied as a URL and baked as the new default
      controls.addEventListener('end', () => {
        const s = new THREE.Spherical().setFromVector3(camera.position.clone().sub(controls.target));
        const q = new URLSearchParams(location.search);
        q.set('az', THREE.MathUtils.radToDeg(s.theta).toFixed(1));
        q.set('pol', THREE.MathUtils.radToDeg(s.phi).toFixed(1));
        q.set('r', (s.radius / maxDim).toFixed(3));
        history.replaceState(null, '', '?' + q);
      });

      // the CRT is always on, showing a phosphor [ ENTER ] button with
      // scanlines; it powers up (line-expand) as the page appears, and
      // clicking the glass replays the cycle. The text lives in 3D on the
      // screen itself, so orbit/zoom/resize can never desync it.
      let mon = null;
      gltf.scene.traverse((o) => { if (o.isMesh && /computer_monitor/i.test(o.name)) mon = o; });

      const cnv = document.createElement('canvas');
      cnv.width = 512; cnv.height = 384; // 4:3, like the tube
      const ctx = cnv.getContext('2d');
      const tex = new THREE.CanvasTexture(cnv);
      tex.colorSpace = THREE.SRGBColorSpace;
      tex.anisotropy = maxAniso;
      function drawScreen(cursorOn, squash = 1) {
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.fillStyle = '#0b130d'; // dark tube
        ctx.fillRect(0, 0, 512, 384);
        ctx.setTransform(1, 0, 0, squash, 0, 192 * (1 - squash)); // CRT line-expand
        const glow = ctx.createRadialGradient(256, 192, 40, 256, 192, 290);
        glow.addColorStop(0, 'rgba(80, 150, 100, 0.16)');
        glow.addColorStop(1, 'rgba(0, 0, 0, 0)');
        ctx.fillStyle = glow;
        ctx.fillRect(0, 0, 512, 384);
        ctx.strokeStyle = '#7dff9f';
        ctx.lineWidth = 3;
        ctx.shadowColor = '#7dff9f';
        ctx.shadowBlur = 16;
        ctx.strokeRect(112, 136, 288, 112); // the button
        ctx.font = "bold 52px ui-monospace, 'Cascadia Mono', Menlo, Consolas, monospace";
        if ('letterSpacing' in ctx) ctx.letterSpacing = '10px';
        ctx.textAlign = 'left';
        ctx.textBaseline = 'middle';
        const tw = ctx.measureText('ENTER').width;
        const x0 = 256 - (tw + 26) / 2;
        ctx.fillStyle = '#b4ffc8';
        ctx.fillText('ENTER', x0, 196);
        if (cursorOn) ctx.fillRect(x0 + tw + 8, 172, 18, 46); // block cursor
        ctx.shadowBlur = 0;
        ctx.fillStyle = 'rgba(0, 0, 0, 0.25)'; // scanlines
        for (let y = 0; y < 384; y += 4) ctx.fillRect(0, y, 512, 2);
        tex.needsUpdate = true;
      }
      drawScreen(true);

      // the ENTER screen uses the monitor's own glass: the GLB has no separate
      // screen mesh, and the CRT face leans back ~17° and bulges ~1 unit, so
      // any flat overlay floats or gets pierced at some angle. Instead, take
      // the monitor's dark-textured front faces (sampled from the atlas),
      // planar-re-UV them against the fitted glass plane, and texture those —
      // surface-conformal, so it looks glued on from every camera angle.
      const atlasCnv = document.createElement('canvas');
      const atlasImg = mon.material.map.image;
      atlasCnv.width = atlasImg.width;
      atlasCnv.height = atlasImg.height;
      atlasCnv.getContext('2d').drawImage(atlasImg, 0, 0);
      const apix = atlasCnv.getContext('2d').getImageData(0, 0, atlasCnv.width, atlasCnv.height).data;

      mon.updateWorldMatrix(true, false);
      const pos = mon.geometry.attributes.position;
      const auv = mon.geometry.attributes.uv;
      const idx = mon.geometry.index;
      const gN = new THREE.Vector3(-0.006, 0.301, 0.954); // fitted glass plane normal (probe)
      const gRight = new THREE.Vector3().crossVectors(new THREE.Vector3(0, 1, 0), gN).normalize();
      const gUp = new THREE.Vector3().crossVectors(gN, gRight);
      const v3 = new THREE.Vector3();
      const worldOf = (i) => v3.fromBufferAttribute(pos, i).applyMatrix4(mon.matrixWorld);

      // dark atlas texel + front-of-monitor position = CRT glass
      const darkAt = (u, v) => {
        const uu = ((u % 1) + 1) % 1, vv = ((v % 1) + 1) % 1;
        const o = (((vv * atlasCnv.height) | 0) * atlasCnv.width + ((uu * atlasCnv.width) | 0)) * 4;
        return Math.max(apix[o], apix[o + 1], apix[o + 2]) <= 80;
      };
      const inGlassArea = (p) => p.z > 33 && p.y > 83 && p.y < 114;

      const glassIdx = [];
      for (let f = 0; f < idx.count; f += 3) {
        const [a, b2, c] = [idx.getX(f), idx.getX(f + 1), idx.getX(f + 2)];
        const u = (auv.getX(a) + auv.getX(b2) + auv.getX(c)) / 3;
        const v = (auv.getY(a) + auv.getY(b2) + auv.getY(c)) / 3;
        if (!darkAt(u, v) || !inGlassArea(worldOf(a))) continue;
        glassIdx.push(a, b2, c);
      }

      // re-UV the glass verts by planar projection onto the fitted plane
      const uniq = [...new Set(glassIdx)];
      let minU = 1e9, maxU = -1e9, minV = 1e9, maxV = -1e9;
      const anchor = new THREE.Vector3(); // world glass center (also used by tests)
      for (const i of uniq) {
        const w = worldOf(i);
        anchor.add(w);
        const u = w.dot(gRight), v = w.dot(gUp);
        minU = Math.min(minU, u); maxU = Math.max(maxU, u);
        minV = Math.min(minV, v); maxV = Math.max(maxV, v);
      }
      anchor.multiplyScalar(1 / uniq.length);
      const uvArr = new Float32Array(pos.count * 2);
      for (const i of uniq) {
        const w = worldOf(i);
        uvArr[i * 2] = (w.dot(gRight) - minU) / (maxU - minU);
        uvArr[i * 2 + 1] = (w.dot(gUp) - minV) / (maxV - minV);
      }
      const gGeo = new THREE.BufferGeometry();
      gGeo.setAttribute('position', pos); // shared with the monitor
      gGeo.setAttribute('uv', new THREE.BufferAttribute(uvArr, 2));
      gGeo.setIndex(glassIdx);
      const glass = new THREE.Mesh(
        gGeo,
        new THREE.MeshBasicMaterial({
          map: tex, transparent: true, opacity: 0, toneMapped: false,
          // same surface as the base mesh — win the depth tie, keep real occlusion
          polygonOffset: true, polygonOffsetFactor: -2, polygonOffsetUnits: -2,
        })
      );
      glass.visible = false;
      mon.add(glass); // inherit the monitor's baked transform

      // hand-written quote + MR5OBOT sign-off on the top sheet (Paper2). The
      // sheet is flat, so a thin quad is enough: PCA of the paper's footprint
      // gives its yaw and extents; the ink redraws once the Caveat font arrives.
      let paper = null;
      gltf.scene.traverse((o) => { if (o.isMesh && /paper2/i.test(o.name)) paper = o; });
      paper.updateWorldMatrix(true, false);
      const pp = paper.geometry.attributes.position;
      const pw = new THREE.Vector3();
      let pcx = 0, pcz = 0, pTop = -1e9;
      const ptsXZ = [];
      for (let i = 0; i < pp.count; i++) {
        pw.fromBufferAttribute(pp, i).applyMatrix4(paper.matrixWorld);
        ptsXZ.push([pw.x, pw.z]);
        pcx += pw.x; pcz += pw.z;
        pTop = Math.max(pTop, pw.y);
      }
      pcx /= pp.count; pcz /= pp.count;
      let sxx = 0, sxz = 0, szz = 0;
      for (const [x, z] of ptsXZ) {
        sxx += (x - pcx) ** 2; sxz += (x - pcx) * (z - pcz); szz += (z - pcz) ** 2;
      }
      const th = 0.5 * Math.atan2(2 * sxz, sxx - szz); // principal axis in XZ
      let L = [Math.cos(th), Math.sin(th)]; // candidate long axis (x, z)
      let U = [-Math.sin(th), Math.cos(th)];
      const span = (a) => {
        let lo = 1e9, hi = -1e9;
        for (const [x, z] of ptsXZ) { const d = x * a[0] + z * a[1]; lo = Math.min(lo, d); hi = Math.max(hi, d); }
        return [lo, hi];
      };
      if (span(U)[1] - span(U)[0] > span(L)[1] - span(L)[0]) [L, U] = [U, L];
      if (L[1] < 0) L = [-L[0], -L[1]]; // long axis points +z → canvas-down faces the chair
      U = [L[1], -L[0]]; // perpendicular, right-handed → text reads left-to-right
      const [u0, u1] = span(U), [l0, l1] = span(L);

      const pcnv = document.createElement('canvas');
      pcnv.width = 512;
      pcnv.height = Math.round((512 * (l1 - l0)) / (u1 - u0));
      const pctx = pcnv.getContext('2d');
      const ptex = new THREE.CanvasTexture(pcnv);
      ptex.colorSpace = THREE.SRGBColorSpace;
      ptex.anisotropy = maxAniso;
      const drawInk = () => {
        pctx.clearRect(0, 0, pcnv.width, pcnv.height);
        pctx.save();
        pctx.translate(pcnv.width / 2, 0);
        pctx.rotate(-0.05); // a hair off-square, like real handwriting
        pctx.textAlign = 'center';
        pctx.textBaseline = 'middle';
        pctx.fillStyle = '#26357c'; // same ink as the pen scribble
        pctx.font = "700 70px Caveat, 'Segoe Script', 'Comic Sans MS', cursive";
        const lines = ['A winner is', 'someone who', 'loses more than', 'any loser.'];
        lines.forEach((l, i) => pctx.fillText(l, 0, pcnv.height * (0.15 + i * 0.1)));
        pctx.font = "700 48px Caveat, 'Segoe Script', 'Comic Sans MS', cursive";
        pctx.fillText('— MR5OBOT', pcnv.width * 0.15, pcnv.height * 0.60);
        pctx.restore();
        ptex.needsUpdate = true;
      };
      drawInk();
      (async () => { // the fonts.css may not be parsed yet — poll, then re-ink
        for (let i = 0; i < 20 && !document.fonts.check('700 92px Caveat'); i++) {
          await document.fonts.load('700 92px Caveat');
          if (!document.fonts.check('700 92px Caveat')) await new Promise((r) => setTimeout(r, 250));
        }
        drawInk();
      })();

      const sheet = new THREE.Mesh(
        new THREE.PlaneGeometry((u1 - u0) * 0.94, (l1 - l0) * 0.94),
        new THREE.MeshBasicMaterial({
          map: ptex, transparent: true, toneMapped: false,
          polygonOffset: true, polygonOffsetFactor: -2, polygonOffsetUnits: -2,
        })
      );
      sheet.rotation.order = 'YXZ'; // yaw to the paper's angle, then lie flat
      sheet.rotation.y = Math.atan2(-U[1], U[0]);
      sheet.rotation.x = -Math.PI / 2;
      sheet.position.set(
        U[0] * ((u0 + u1) / 2) + L[0] * ((l0 + l1) / 2),
        pTop + 0.05,
        U[1] * ((u0 + u1) / 2) + L[1] * ((l0 + l1) / 2)
      );
      scene.add(sheet);

      // a small pulsing "!" over the note's corner says "read this" — pure
      // eye-catch in the same phosphor green, no interaction
      const ecnv = document.createElement('canvas');
      ecnv.width = 64; ecnv.height = 96;
      const ectx = ecnv.getContext('2d');
      ectx.fillStyle = '#7dff9f';
      ectx.shadowColor = '#7dff9f';
      ectx.shadowBlur = 12;
      ectx.beginPath();
      ectx.roundRect(23, 10, 18, 52, 9); // fat bar — a font "!" reads as a sliver
      ectx.fill();
      ectx.beginPath();
      ectx.arc(32, 81, 10, 0, Math.PI * 2); // the dot
      ectx.fill();
      const etex = new THREE.CanvasTexture(ecnv);
      etex.colorSpace = THREE.SRGBColorSpace;
      const bang = new THREE.Sprite(new THREE.SpriteMaterial({ map: etex, transparent: true, opacity: 0.9, toneMapped: false }));
      bang.scale.set(5.2, 7.8, 1);
      const bangU = u0 + (u1 - u0) * 0.5, bangL = l0 + (l1 - l0) * 0.82; // below the pen, near edge of the sheet
      const bangY = pTop + 4.2;
      bang.position.set(U[0] * bangU + L[0] * bangL, bangY, U[1] * bangU + L[1] * bangL);
      scene.add(bang);

      // hovering the phone fans the social links out of it (contact lives in
      // the phone): cream keycap sprites that rise staggered, glow-scale when
      // hot, and open the link on click
      const SOCIALS = [
        ['github', 'https://github.com/MR-5OBOT'],
        ['x', 'https://x.com/MR_5OBOT'],
        ['telegram', 'https://t.me/MR_5OBOT'],
        ['youtube', 'https://youtube.com/@mr5obot'],
      ];
      const hubParts = [];
      gltf.scene.traverse((o) => { if (o.isMesh && /^Phone/i.test(o.name)) hubParts.push(o); });
      const hubBox = new THREE.Box3();
      for (const h of hubParts) hubBox.union(new THREE.Box3().setFromObject(h));
      const hubC = hubBox.getCenter(new THREE.Vector3());
      const iconW = 6.5, fanGap = 7.4;
      const fan = [];
      SOCIALS.forEach(([name, url], i) => {
        const img = new Image();
        img.src = `/assets/icons/${name}.png`;
        img.onload = () => {
          const c = document.createElement('canvas');
          c.width = c.height = 128;
          const g = c.getContext('2d');
          g.beginPath();
          g.roundRect(4, 4, 120, 120, 30);
          g.fillStyle = '#e7e2d4'; // hardware cream, like the keycaps
          g.fill();
          g.lineWidth = 3;
          g.strokeStyle = '#b9b3a3';
          g.stroke();
          g.drawImage(img, 24, 24, 80, 80); // simpleicons: black on transparent
          const t = new THREE.CanvasTexture(c);
          t.colorSpace = THREE.SRGBColorSpace;
          t.anisotropy = maxAniso;
          const s = new THREE.Sprite(new THREE.SpriteMaterial({ map: t, transparent: true, opacity: 0, toneMapped: false }));
          s.scale.setScalar(iconW);
          s.position.set(hubC.x, hubBox.max.y, hubC.z);
          s.userData = { url, idx: i, outY: 6 + (SOCIALS.length - 1 - i) * fanGap }; // first link on top
          s.visible = false;
          scene.add(s);
          fan[i] = s;
        };
      });
      // a bobbing phosphor arrow over the phone says "hover here"; it fades
      // while the fan is out and returns when it sinks
      const acnv = document.createElement('canvas');
      acnv.width = 96; acnv.height = 128;
      const actx2 = acnv.getContext('2d');
      actx2.strokeStyle = '#7dff9f';
      actx2.lineWidth = 10;
      actx2.lineCap = 'round';
      actx2.lineJoin = 'round';
      actx2.shadowColor = '#7dff9f';
      actx2.shadowBlur = 14;
      actx2.beginPath();
      actx2.moveTo(48, 18); actx2.lineTo(48, 82); // shaft
      actx2.moveTo(26, 62); actx2.lineTo(48, 92); actx2.lineTo(70, 62); // head
      actx2.stroke();
      const atex = new THREE.CanvasTexture(acnv);
      atex.colorSpace = THREE.SRGBColorSpace;
      const arrow = new THREE.Sprite(new THREE.SpriteMaterial({ map: atex, transparent: true, opacity: 0, toneMapped: false }));
      arrow.scale.set(7, 9.4, 1);
      const arrowY = hubBox.max.y + 6.5;
      arrow.position.set(hubC.x, arrowY, hubC.z);
      arrow.userData.indicator = true; // hovering the arrow counts as the CD
      scene.add(arrow);

      // fan zones, pure screen-space geometry with hysteresis (raycasting the
      // sprites for open/close caused every flicker bug so far — moving icons
      // re-armed the fan, ghost sprites ate rays). Two capsules around the
      // column axis, radii scaled by the icons' current projected size so
      // zooming keeps the feel identical:
      //   trigger — the arrow's spot + phone; the only thing that OPENS
      //   keep    — the whole column, wider; only KEEPS an open fan open
      const fanTopY = hubBox.max.y + 6 + (SOCIALS.length - 1) * fanGap + 4;
      const vA = new THREE.Vector3(), vB = new THREE.Vector3(), vC = new THREE.Vector3();
      const px2 = (v, out) => {
        const q = v.project(camera);
        out[0] = ((q.x + 1) / 2) * innerWidth;
        out[1] = ((1 - q.y) / 2) * innerHeight;
        return q.z < 1; // false = behind the camera, projection is garbage
      };
      const segDist = (p0, a, b) => {
        const dx = b[0] - a[0], dy = b[1] - a[1];
        const t = Math.max(0, Math.min(1, ((p0[0] - a[0]) * dx + (p0[1] - a[1]) * dy) / (dx * dx + dy * dy || 1)));
        return Math.hypot(p0[0] - (a[0] + t * dx), p0[1] - (a[1] + t * dy));
      };
      const pxA = [0, 0], pxB = [0, 0], pxC = [0, 0];
      const fanZone = () => {
        if (!px2(vA.set(hubC.x, hubBox.max.y, hubC.z), pxA)) return { trigger: false, keep: false };
        px2(vB.set(hubC.x, fanTopY, hubC.z), pxB);
        px2(vC.set(hubC.x, hubBox.max.y + iconW, hubC.z), pxC);
        const iconPx = Math.max(8, Math.hypot(pxC[0] - pxA[0], pxC[1] - pxA[1])); // one icon in px
        const arrowTop = [pxA[0] + (pxB[0] - pxA[0]) * 0.45, pxA[1] + (pxB[1] - pxA[1]) * 0.45];
        const pt = [((pointer.x + 1) / 2) * innerWidth, ((1 - pointer.y) / 2) * innerHeight];
        return {
          trigger: segDist(pt, pxA, arrowTop) < iconPx * 1.05,
          keep: segDist(pt, pxA, pxB) < iconPx * 1.6,
        };
      };
      // don't pop an indicator when its anchor is hidden behind something
      const clearView = (x, y, z, selves) => {
        vB.set(x, y, z);
        const dist = vA.copy(vB).sub(camera.position).length();
        raycaster.set(camera.position, vA.normalize());
        const h = raycaster.intersectObject(gltf.scene, true)[0];
        return !h || selves.includes(h.object) || h.distance > dist - 1;
      };

      // the floppy disk gets the same treatment: its own arrow, and hovering
      // raises a PROJECTS tag — click stays unwired until the projects page
      let floppy = null;
      gltf.scene.traverse((o) => { if (o.isMesh && /floppy/i.test(o.name)) floppy = o; });
      const flBox = new THREE.Box3().setFromObject(floppy);
      const flC = flBox.getCenter(new THREE.Vector3());
      const arrow2 = new THREE.Sprite(new THREE.SpriteMaterial({ map: atex, transparent: true, opacity: 0, toneMapped: false }));
      arrow2.scale.set(7, 9.4, 1);
      const arrow2Y = flBox.max.y + 6.5;
      arrow2.position.set(flC.x, arrow2Y, flC.z);
      scene.add(arrow2);

      const lcnv = document.createElement('canvas');
      lcnv.width = 256; lcnv.height = 110;
      const lctx = lcnv.getContext('2d');
      lctx.beginPath();
      lctx.roundRect(4, 4, 248, 102, 24);
      lctx.fillStyle = '#e7e2d4'; // same keycap cream as the fan icons
      lctx.fill();
      lctx.lineWidth = 3;
      lctx.strokeStyle = '#b9b3a3';
      lctx.stroke();
      lctx.textAlign = 'center';
      lctx.textBaseline = 'middle';
      lctx.fillStyle = '#2e2c27';
      lctx.font = "bold 34px ui-monospace, 'Cascadia Mono', Menlo, Consolas, monospace";
      lctx.fillText('PROJECTS', 128, 42);
      lctx.fillStyle = '#8a857a';
      lctx.font = "16px ui-monospace, 'Cascadia Mono', Menlo, Consolas, monospace";
      lctx.fillText('coming soon', 128, 78);
      const ltex = new THREE.CanvasTexture(lcnv);
      ltex.colorSpace = THREE.SRGBColorSpace;
      ltex.anisotropy = maxAniso;
      const tag = new THREE.Sprite(new THREE.SpriteMaterial({ map: ltex, transparent: true, opacity: 0, toneMapped: false }));
      const tagW = 15.5;
      tag.scale.set(tagW, tagW * (110 / 256), 1);
      tag.position.set(flC.x, flBox.max.y, flC.z);
      tag.visible = false;
      scene.add(tag);

      const flopZone = () => {
        if (!px2(vA.set(flC.x, flBox.max.y, flC.z), pxA)) return { trigger: false, keep: false };
        px2(vB.set(flC.x, flBox.max.y + 13, flC.z), pxB);
        px2(vC.set(flC.x, flBox.max.y + iconW, flC.z), pxC);
        const iconPx = Math.max(8, Math.hypot(pxC[0] - pxA[0], pxC[1] - pxA[1]));
        const pt = [((pointer.x + 1) / 2) * innerWidth, ((1 - pointer.y) / 2) * innerHeight];
        const d = segDist(pt, pxA, pxB);
        return { trigger: d < iconPx * 1.05, keep: d < iconPx * 1.6 };
      };

      // referee-cam flight: a raised quadratic-bezier sweep between views;
      // controls sleep while traveling and re-target on landing
      const backBtn = document.getElementById('back');
      let fly = null, homeCam = null, homeTgt = null, atCab = false;
      function flyTo(pos, tgt, toCab) {
        if (toCab) { homeCam = camera.position.clone(); homeTgt = controls.target.clone(); }
        fly = { t: 0, p0: camera.position.clone(), p2: pos.clone(), t0: controls.target.clone(), t1: tgt.clone() };
        fly.p1 = fly.p0.clone().add(fly.p2).multiplyScalar(0.5);
        fly.p1.y += maxDim * 0.55; // the crane arc
        controls.enabled = false;
        atCab = toCab;
        if (toCab) cabRoot.visible = true; // reveal for the trip; hidden again once home
        if (!toCab) backBtn.classList.remove('on');
      }
      const goHome = () => { if (atCab && !fly) flyTo(homeCam, homeTgt, false); };
      backBtn.addEventListener('click', goHome);
      addEventListener('keydown', (e) => { if (e.key === 'Escape') goHome(); });

      // ENTER's destination: the filing cabinet on its own pedestal off to
      // the viewer's right. 46MB of textures — stream it in the background
      // after the desk is up; ENTER queues the flight if clicked early.
      const cabSpot = new THREE.Vector3(center.x + maxDim * 1.7, 0, center.z);
      // what's filed in the cabinet: PROJECTS[i] goes in drawer i counting the
      // top row left→right (as you face it), then down. Hovering a drawer
      // paints its project onto the gallery frame beside the cabinet; click
      // (drawer front or frame) follows url. Intros lifted from v1's stuff page.
      const PROJECTS = [
        { title: 'RISK_MODEL_TESTER', chip: 'RISK', tech: 'PYTHON · MONTE CARLO',
          intro: `Throws your risk model into Monte Carlo simulations and shows you the thousand ways it can die — before the market demonstrates one for free.`,
          url: 'https://github.com/MR-5OBOT/risk-model-tester' },
        { title: 'PROBABILITY_SIM', chip: 'TRADING', tech: 'PYTHON · PROBABILITY',
          intro: `Simulates trading systems across different inputs, probabilities, and market moods — so the strategy can blow up in theory instead of in production.`,
          url: 'https://github.com/MR-5OBOT/probability-simulator' },
        { title: 'POSITION_DEALER_EA', chip: 'MT5 EA', tech: 'MT5 EA · TOOLS',
          intro: `A multi-functional trading assistant built around one idea: never place a trade that breaks your risk rules. Size every position by risk, set stops and targets visually on the chart, enforce a hard maximum-risk limit, and fire market or pending orders in one click — without ever doing the lot math yourself.`,
          url: 'https://www.mql5.com/en/market/product/182273?source=Site+Profile+Seller' },
        { title: 'TJ_ANALYSER_MOBILE', chip: 'WIP', tech: 'MOBILE · TRADING',
          intro: `A trading journal for your phone, so you can log the loss the moment it happens instead of pretending it didn't. Currently 90% idea, 10% code. Ships whenever the will to live returns.`,
          url: null },
      ];
      let cabCam = null, cabTgt = null, pendingFly = false, drawers = [], cabTag = null, cabTagY = 0;
      let framedProj = null, paintFrame = null, frameObj = null, frameBaseY = 0;
      const cabRoot = new THREE.Group(); // hidden until ENTER — no spoilers when orbiting
      cabRoot.visible = false;
      scene.add(cabRoot);
      new GLTFLoader().load('/assets/old_filing_cabinet.glb', (g) => {
        const cab = g.scene;
        let knob = null, shelf = null;
        cab.traverse((o) => {
          if (!o.isMesh) return;
          if (/knob/i.test(o.name)) knob = o;
          if (/shelf/i.test(o.name)) shelf = o;
          if (o.material.map) o.material.map.anisotropy = maxAniso;
        });
        // front = the knob side; yaw it to face the desk (angles from the
        // unscaled boxes — uniform scale keeps directions, but don't mix)
        const cb = new THREE.Box3().setFromObject(cab);
        const cc = cb.getCenter(new THREE.Vector3());
        const kc = new THREE.Box3().setFromObject(knob).getCenter(new THREE.Vector3());
        const front = Math.atan2(kc.x - cc.x, kc.z - cc.z);
        const want = Math.atan2(center.x - cabSpot.x, center.z - cabSpot.z);
        cab.rotation.y = want - front;
        cab.scale.setScalar((maxDim * 0.55) / (cb.max.y - cb.min.y)); // desk-scale height
        // re-measure after scale+yaw, drop it onto the floor at the spot
        const cb2 = new THREE.Box3().setFromObject(cab);
        const cc2 = cb2.getCenter(new THREE.Vector3());
        cab.position.set(cabSpot.x - cc2.x, box.min.y - cb2.min.y, cabSpot.z - cc2.z);
        cabRoot.add(cab);
        const discR = (Math.hypot(cb2.max.x - cb2.min.x, cb2.max.z - cb2.min.z) / 2) * 1.15;
        const disc = new THREE.Mesh(new THREE.CylinderGeometry(discR, discR, baseH, 64), base.material);
        disc.position.set(cabSpot.x, box.min.y - baseH / 2, cabSpot.z);
        cabRoot.add(disc);
        // drawers: the merged Shelf/Knob meshes hold 16 islands each — split
        // them into per-cell meshes (shared GPU buffers, new index) so hover
        // can slide a front+knob pair out. The body is one closed shell, so
        // it's a shallow tease-open, not a full pull-out.
        const split = (mesh) => {
          const geo = mesh.geometry, pos = geo.attributes.position, idx = geo.index.array;
          const vmap = new Map(), wid = new Int32Array(pos.count);
          for (let i = 0; i < pos.count; i++) {
            const k = pos.getX(i).toFixed(3) + ',' + pos.getY(i).toFixed(3) + ',' + pos.getZ(i).toFixed(3);
            if (!vmap.has(k)) vmap.set(k, vmap.size);
            wid[i] = vmap.get(k); // weld split verts so islands connect
          }
          const par = Int32Array.from({ length: vmap.size }, (_, i) => i);
          const find = (a) => { while (par[a] !== a) a = par[a] = par[par[a]]; return a; };
          for (let t = 0; t < idx.length; t += 3) {
            const a = find(wid[idx[t]]);
            par[find(wid[idx[t + 1]])] = a;
            par[find(wid[idx[t + 2]])] = a;
          }
          const isles = new Map();
          for (let t = 0; t < idx.length; t += 3) {
            const r = find(wid[idx[t]]);
            if (!isles.has(r)) isles.set(r, []);
            isles.get(r).push(idx[t], idx[t + 1], idx[t + 2]);
          }
          geo.setIndex([]); // the original stops drawing; islands take over
          return [...isles.values()].map((tris) => {
            const sub = new THREE.BufferGeometry();
            for (const n in geo.attributes) sub.setAttribute(n, geo.attributes[n]);
            sub.setIndex(tris);
            const m = new THREE.Mesh(sub, mesh.material);
            mesh.add(m); // child of the original = inherits the baked FBX matrix
            return m;
          });
        };
        cab.updateWorldMatrix(true, true);
        const fronts = split(shelf), knobs = split(knob);
        // slide vector: a quarter of the depth toward the desk, expressed in
        // each parent's local frame (front and knob carry different matrices)
        const slideW = new THREE.Vector3(center.x - cabSpot.x, 0, center.z - cabSpot.z)
          .normalize().multiplyScalar((cb2.max.x - cb2.min.x) * 0.24);
        const localOff = (m) => m.parent.worldToLocal(m.parent.getWorldPosition(new THREE.Vector3()).add(slideW));
        const offF = localOff(fronts[0]), offK = localOff(knobs[0]);
        // island bbox — walk its OWN index; the shared position buffer
        // holds all 16 islands, so Box3.setFromObject would measure them all
        const isleBox = (m) => {
          const b = new THREE.Box3(), v = new THREE.Vector3();
          const pos = m.geometry.attributes.position;
          for (const i of m.geometry.index.array) b.expandByPoint(v.fromBufferAttribute(pos, i).applyMatrix4(m.parent.matrixWorld));
          return b;
        };
        const kcs = knobs.map((k) => ({ k, c: isleBox(k).getCenter(new THREE.Vector3()) }));
        drawers = fronts.map((f, i) => {
          const fb = isleBox(f), fc = fb.getCenter(new THREE.Vector3()), fs = fb.getSize(new THREE.Vector3());
          kcs.sort((a, b) => a.c.distanceToSquared(fc) - b.c.distanceToSquared(fc));
          const parts = [[f, offF], [kcs.shift().k, offK]]; // claim the nearest knob
          for (const [m] of parts) m.userData.drawer = i;
          // hover reads a STATIC invisible proxy parked at the closed spot —
          // raycasting the sliding panel itself is a feedback loop (open moves
          // it out from under the pointer, which closes it, which reopens it)
          const proxy = new THREE.Mesh(new THREE.BoxGeometry(Math.max(fs.x, 8), fs.y, fs.z));
          proxy.position.copy(fc);
          proxy.visible = false; // invisible meshes still raycast
          proxy.userData.drawer = i;
          cabRoot.add(proxy);
          return { parts, t: 0, c: fc, s: fs };
        });
        // file the projects: sort drawers into reading order (top row
        // left→right as seen from the arrival camera, then down) and assign
        // PROJECTS in that order. Hover paints the gallery frame; the drawer
        // front itself is the click target for the project's url.
        const slideDir = slideW.clone().normalize();
        const rightAxis = new THREE.Vector3(0, 1, 0).cross(slideDir); // screen-right at the head-on view
        const yTop = Math.max(...drawers.map((d) => d.c.y));
        const pitch = (yTop - Math.min(...drawers.map((d) => d.c.y))) / 3 || 1;
        [...drawers]
          .sort((a, b) => Math.round((yTop - a.c.y) / pitch) - Math.round((yTop - b.c.y) / pitch)
            || a.c.dot(rightAxis) - b.c.dot(rightAxis))
          .forEach((d, i) => {
            const proj = PROJECTS[i];
            if (!proj) return;
            d.proj = proj;
            d.url = proj.url;
          });
        // the gallery frame: hangs in the air on the viewer's left of the
        // cabinet, painted in the monitor's phosphor. Its spot is computed now
        // (synchronously) so the arrival view can frame cabinet + frame both;
        // the GLB drops onto the spot whenever it lands. It never moves or
        // hides, so raycasting it for hover/click is flicker-safe.
        const h = cb2.max.y - cb2.min.y;
        const cabW = Math.abs((cb2.max.x - cb2.min.x) * rightAxis.x) + Math.abs((cb2.max.z - cb2.min.z) * rightAxis.z);
        const frameH = h * 0.9, frameW = frameH * 1.6 / 1.3, frameGap = frameW * 0.12;
        const framePos = new THREE.Vector3(cabSpot.x, box.min.y + h * 0.55, cabSpot.z)
          .addScaledVector(rightAxis, -(cabW / 2 + frameGap + frameW / 2));
        // its canvas: same dark tube + phosphor + scanlines as the desk CRT
        const fcnv = document.createElement('canvas');
        fcnv.width = 1024; fcnv.height = 818; // the Tableau quad's 1.25 aspect
        const fctx = fcnv.getContext('2d');
        const ftex = new THREE.CanvasTexture(fcnv);
        ftex.colorSpace = THREE.SRGBColorSpace;
        ftex.anisotropy = maxAniso;
        ftex.flipY = false; // glTF UVs put v=0 at the top row, like the canvas
        const mono = "ui-monospace, 'Cascadia Mono', Menlo, Consolas, monospace";
        const wrapText = (text, font, maxW) => {
          fctx.font = font;
          const lines = [];
          let line = '';
          for (const w of text.split(' ')) {
            const t = line ? line + ' ' + w : w;
            if (fctx.measureText(t).width > maxW && line) { lines.push(line); line = w; }
            else line = t;
          }
          if (line) lines.push(line);
          return lines;
        };
        paintFrame = (proj) => {
          framedProj = proj;
          fctx.fillStyle = '#0b130d'; // dark tube
          fctx.fillRect(0, 0, 1024, 818);
          const glow = fctx.createRadialGradient(512, 409, 80, 512, 409, 620);
          glow.addColorStop(0, 'rgba(80, 150, 100, 0.16)');
          glow.addColorStop(1, 'rgba(0, 0, 0, 0)');
          fctx.fillStyle = glow;
          fctx.fillRect(0, 0, 1024, 818);
          fctx.textAlign = 'center';
          fctx.textBaseline = 'middle';
          fctx.shadowColor = '#7dff9f';
          if (!proj) { // idle card, until a drawer is hovered
            fctx.shadowBlur = 18;
            fctx.fillStyle = '#b4ffc8';
            fctx.font = 'bold 84px ' + mono;
            fctx.fillText('PROJECTS.DB', 512, 350);
            fctx.shadowBlur = 8;
            fctx.fillStyle = '#7dff9f';
            fctx.font = '44px ' + mono;
            fctx.fillText('── hover a drawer ──', 512, 480);
          } else {
            fctx.shadowBlur = 16;
            fctx.fillStyle = '#b4ffc8';
            fctx.font = 'bold 62px ' + mono;
            fctx.fillText(proj.title, 512, 100);
            fctx.font = 'bold 34px ' + mono;
            const chipW = fctx.measureText(proj.chip).width + 44;
            fctx.fillStyle = '#7dff9f';
            fctx.fillRect(512 - chipW / 2, 152, chipW, 54); // inverse-video chip
            fctx.shadowBlur = 0;
            fctx.fillStyle = '#0b130d';
            fctx.fillText(proj.chip, 512, 181);
            // intro: wrapped, and shrunk to fit when it runs long
            let size = 40;
            let lines = wrapText(proj.intro, size + 'px ' + mono, 880);
            if (lines.length * size * 1.35 > 400) {
              size = Math.max(29, Math.floor(400 / (lines.length * 1.35)));
              lines = wrapText(proj.intro, size + 'px ' + mono, 880);
            }
            fctx.shadowBlur = 8;
            fctx.fillStyle = '#7dff9f';
            lines.forEach((l, i) => fctx.fillText(l, 512, 262 + i * size * 1.35));
            fctx.font = '32px ' + mono;
            fctx.fillStyle = 'rgba(125, 255, 159, 0.55)';
            fctx.fillText(proj.tech, 512, 704);
            fctx.font = 'bold 36px ' + mono;
            fctx.fillStyle = '#b4ffc8';
            fctx.shadowBlur = 14;
            fctx.fillText(proj.url ? '── click to open ──' : 'SOON™', 512, 764);
          }
          fctx.shadowBlur = 0;
          fctx.fillStyle = 'rgba(0, 0, 0, 0.25)'; // scanlines
          for (let y = 0; y < 818; y += 6) fctx.fillRect(0, y, 1024, 3);
          ftex.needsUpdate = true;
        };
        paintFrame(null);
        new GLTFLoader().load('/assets/deco_cadre.glb', (fg) => {
          const fr = fg.scene;
          fr.rotation.y = Math.atan2(slideDir.x, slideDir.z); // face where the cabinet faces
          const fb = new THREE.Box3().setFromObject(fr);
          fr.scale.setScalar(frameH / (fb.max.y - fb.min.y));
          const fb2 = new THREE.Box3().setFromObject(fr);
          fr.position.copy(framePos).sub(fb2.getCenter(new THREE.Vector3()));
          fr.traverse((o) => {
            if (!o.isMesh) return;
            o.userData.frame = true;
            if (o.material.name === 'Tableau')
              o.material = new THREE.MeshBasicMaterial({ map: ftex, toneMapped: false }); // self-lit, like the CRT
            else if (o.material.map) o.material.map.anisotropy = maxAniso;
          });
          frameBaseY = fr.position.y;
          frameObj = fr;
          cabRoot.add(fr);
        });
        // arrival view: near head-on, slightly above, widened and re-centered
        // so the frame shares the shot — angles from the ?az/?pol/?r knobs
        cabTgt = new THREE.Vector3(cabSpot.x, box.min.y + h * 0.5, cabSpot.z)
          .addScaledVector(rightAxis, -(frameGap + frameW) / 2);
        cabCam = cabTgt.clone().add(new THREE.Vector3()
          .setFromSpherical(new THREE.Spherical(maxDim * 1.55, deg(70.6), deg(-89.5))));
        // floating hand-scrawled label over the top — drawn letter by letter
        // with jitter and a double pen pass so it reads as handwriting
        const tcnv = document.createElement('canvas');
        tcnv.width = 1024; tcnv.height = 224;
        const tctx = tcnv.getContext('2d');
        tctx.font = "italic 96px 'Segoe Print', 'Bradley Hand', 'Comic Sans MS', cursive";
        tctx.textBaseline = 'middle';
        tctx.strokeStyle = '#417076'; // the cabinet's own teal
        tctx.lineWidth = 2.5;
        tctx.lineJoin = 'round';
        tctx.shadowColor = '#417076';
        tctx.shadowBlur = 16;
        const label = 'Projects Cabinet';
        let lx = (tcnv.width - tctx.measureText(label).width) / 2;
        for (const ch of label) {
          tctx.save();
          tctx.translate(lx, 112 + (Math.random() - 0.5) * 9);
          tctx.rotate((Math.random() - 0.5) * 0.09);
          tctx.strokeText(ch, 0, 0);
          tctx.strokeText(ch, 1.5, -1); // the second pass of the pen
          tctx.restore();
          lx += tctx.measureText(ch).width;
        }
        const ttex = new THREE.CanvasTexture(tcnv);
        ttex.colorSpace = THREE.SRGBColorSpace;
        ttex.anisotropy = maxAniso;
        cabTag = new THREE.Sprite(new THREE.SpriteMaterial({ map: ttex, transparent: true, toneMapped: false }));
        const ctw = (cb2.max.z - cb2.min.z) * 0.72;
        cabTag.scale.set(ctw, ctw * (224 / 1024), 1);
        cabTagY = box.min.y + h * 1.24;
        cabTag.position.set(cabSpot.x, cabTagY, cabSpot.z);
        cabRoot.add(cabTag);
        if (pendingFly) { pendingFly = false; flyTo(cabCam, cabTgt, true); }
      });

      const raycaster = new THREE.Raycaster();
      const pointer = new THREE.Vector2(2, 2); // offscreen until first move
      let lit = 0, fanT = 0, fanOpen = false, zoneLeftAt = 0, cursorPrev = null, pointerPrev = false, squashPrev = 0, downAt = null;
      let flopT = 0, flopOpen = false, flopLeftAt = 0;
      const trackPointer = (e) => pointer.set((e.clientX / innerWidth) * 2 - 1, -(e.clientY / innerHeight) * 2 + 1);
      addEventListener('pointermove', trackPointer);
