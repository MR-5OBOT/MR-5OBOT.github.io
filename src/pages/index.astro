---
// v3 home — full-screen three.js point-cloud hero.
// Scene constants lifted from agrshch.com's model-viewer (behavior, not assets):
// same camera formula, orbit limits, cursor-follow, and cylinder vitals text.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MR5OBOT</title>
    <meta name="description" content="OHLC trader and token burner." />
    <link rel="icon" type="image/png" href="/assets/profile-2.png" />
    <style>
      html, body { margin: 0; height: 100%; background: #000; overflow: hidden; }
      canvas { display: block; }
      #loading {
        position: fixed; inset: 0; display: grid; place-items: center;
        color: #666; font: 16px 'Helvetica Neue', Arial, sans-serif;
      }
      #info {
        position: fixed; left: 0; right: 0; bottom: 24px; z-index: 2;
        text-align: center; color: #9c9c9c;
        font: 15px/1.55 'Helvetica Neue', Arial, sans-serif;
      }
      #info a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
      #info a:hover { color: #ff2020; }
    </style>
  </head>
  <body>
    <div id="loading">Loading&hellip;</div>

    <div id="info">
      <p>MR5OBOT &nbsp;|&nbsp; OHLC Trader &amp; Token Burner</p>
      <p>
        <a href="https://github.com/MR-5OBOT" target="_blank">GitHub</a> &nbsp;|&nbsp;
        <a href="https://x.com/MR_5OBOT" target="_blank">X</a> &nbsp;|&nbsp;
        <a href="https://t.me/MR_5OBOT" target="_blank">Telegram</a> &nbsp;|&nbsp;
        <a href="https://youtube.com/@mr5obot" target="_blank">YouTube</a> &nbsp;|&nbsp;
        <a href="mailto:yassir7m7@gmail.com">Email</a>
      </p>
    </div>

    <script type="module" is:inline>
      import * as THREE from 'https://esm.sh/three@0.163.0';
      import { OrbitControls } from 'https://esm.sh/three@0.163.0/examples/jsm/controls/OrbitControls.js';

      const isMobile = matchMedia('(max-width: 768px)').matches;
      const deg = (d) => d * (Math.PI / 180);

      const STATS = [
        'Pulse: 77',
        'PnL Today: -$4.20',
        'Open Positions: 3',
        'Win Rate (30d): 41%',
        'Tokens Burned: 2.1M',
        'Coffee Level: 86%',
        'Last Sync: just now',
      ];

      // ---- reference-site tuning (agrshch.com constants) ----
      const MODEL = {
        offset: { x: 0, y: isMobile ? -0.15 : -0.25, z: isMobile ? -0.5 : 0 },
        // ref uses 3.0 (fills/crops the frame); 2.0 = the previous commit's
        // apparent hero size, whole drawing visible on screen
        scale: isMobile ? 1.73 : 2.3,
        cursorFollow: { maxAngle: 10, smoothing: 0.005 },
      };
      const CAMERA = {
        fov: 55,
        distanceMultiplier: 2.2,
        // camera level with the target: launch shows the drawing perfectly flat,
        // any parallax appears only once the user drags / moves the mouse
        heightFraction: 0.58,
        targetHeightFraction: 0.58,
        initialAzimuth: 0,
        initialPolar: 0,
      };
      // tighter than the ref's ±45: our depth is estimated from one image,
      // so we stop before the angles where the illusion falls apart
      const LIMITS = { minAzimuth: -16, maxAzimuth: 16, minPolar: 75, maxPolar: 95 };

      const scene = new THREE.Scene();
      scene.background = new THREE.Color(0x000000);

      const camera = new THREE.PerspectiveCamera(CAMERA.fov, innerWidth / innerHeight, 0.01, 1000);

      const renderer = new THREE.WebGLRenderer({ antialias: true });
      renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
      renderer.setSize(innerWidth, innerHeight);
      document.body.appendChild(renderer.domElement);

      // ---- point cloud sampled from the hero illustration's dark pixels ----
      // depthUrl is an AI-estimated depth map (white = near) of the same image;
      // it gives every point real z structure, like the reference's scan.
      async function sampleImage(url, depthUrl, targetW = 1000) {
        const load = (src) =>
          new Promise((res, rej) => {
            const i = new Image();
            i.onload = () => res(i);
            i.onerror = rej;
            i.src = src;
          });
        const [img, depthImg] = await Promise.all([load(url), load(depthUrl)]);
        const read = (image) => {
          const c = document.createElement('canvas');
          c.width = targetW;
          c.height = Math.round((img.height / img.width) * targetW);
          const x = c.getContext('2d', { willReadFrequently: true });
          x.drawImage(image, 0, 0, c.width, c.height);
          return { data: x.getImageData(0, 0, c.width, c.height).data, W: c.width, H: c.height };
        };
        const { data: d, W, H } = read(img);
        const { data: dd } = read(depthImg);
        const pts = []; // quads: x, y, darkness 0..1, depth 0..1 (1 = near)
        let minX = 1e9, maxX = -1e9, minY = 1e9, maxY = -1e9;
        for (let py = 0; py < H; py++)
          for (let px = 0; px < W; px++) {
            const i4 = (py * W + px) * 4;
            const lum = (d[i4] + d[i4 + 1] + d[i4 + 2]) / 3;
            const dark = (250 - lum) / 250;
            // quadratic weighting: linework gets far more points than grey fills
            if (d[i4 + 3] > 128 && Math.random() < dark * dark) {
              pts.push(px, py, dark, dd[i4] / 255);
              if (px < minX) minX = px;
              if (px > maxX) maxX = px;
              if (py < minY) minY = py;
              if (py > maxY) maxY = py;
            }
          }
        // normalize to the drawing's bounding box so the cloud sits centered
        const w = Math.max(1, maxX - minX), h = Math.max(1, maxY - minY);
        for (let i = 0; i < pts.length; i += 4) {
          pts[i] = (pts[i] - minX) / w;
          pts[i + 1] = (pts[i + 1] - minY) / h;
        }
        return { pts, aspect: h / w };
      }

      // Every point sits at its real estimated depth (plus a thin jitter for
      // point-cloud thickness), so rotation shows true parallax like a scan.
      // x/y are shrunk by depth to cancel perspective from the initial camera:
      // the launch view matches the flat drawing exactly, rotation reveals 3D.
      function imageCloud({ pts, aspect }, count, width, depthRange) {
        const n = pts.length / 4;
        const pos = new Float32Array(count * 3);
        const col = new Float32Array(count * 3);
        // camera distance in the cloud's local units (world dist / model scale)
        const D = ((width / 2) / Math.tan(deg(CAMERA.fov) / 2)) * CAMERA.distanceMultiplier / MODEL.scale;
        for (let i = 0; i < count; i++) {
          const j = ((Math.random() * n) | 0) * 4;
          const dark = pts[j + 2];
          const z = (pts[j + 3] - 0.5) * depthRange + dark * 0.05 + (Math.random() - 0.5) * 0.04;
          const k = (D - z) / D;
          pos[i * 3] = ((pts[j] - 0.5) * width + (Math.random() - 0.5) * 0.008) * k;
          pos[i * 3 + 1] = ((0.5 - pts[j + 1]) * width * aspect + (Math.random() - 0.5) * 0.008) * k;
          pos[i * 3 + 2] = z;
          // red brightness follows the drawing's darkness so linework reads at once
          const b = 0.35 + 0.65 * dark;
          col[i * 3] = b;
          col[i * 3 + 1] = b * 0.05;
          col[i * 3 + 2] = b * 0.05;
        }
        const g = new THREE.BufferGeometry();
        g.setAttribute('position', new THREE.BufferAttribute(pos, 3));
        g.setAttribute('color', new THREE.BufferAttribute(col, 3));
        return g;
      }

      const model = new THREE.Points(
        imageCloud(
          await sampleImage('/assets/hero.webp', '/assets/hero-depth.png'),
          isMobile ? 120000 : 260000, 2.56, 0.7
        ),
        new THREE.PointsMaterial({ vertexColors: true, size: 0.006, sizeAttenuation: true })
      );

      // ---- place model + camera exactly like the reference's setupModel ----
      const box = new THREE.Box3().setFromObject(model);
      const center = box.getCenter(new THREE.Vector3());
      const size = box.getSize(new THREE.Vector3());
      model.position.sub(center);
      model.position.y += size.y / 2;
      model.position.x += MODEL.offset.x;
      model.position.y += MODEL.offset.y;
      model.position.z += MODEL.offset.z;
      model.scale.setScalar(MODEL.scale);
      scene.add(model);

      // Ground scatter under the model, like the reference's floor scan line:
      // a thin bell-curve band of red dots, denser under the figure, ragged edges.
      {
        const count = isMobile ? 14000 : 28000;
        const pos = new Float32Array(count * 3);
        // floor sits a bit below the hero so they read as separate pieces
        const baseY = model.position.y - (size.y / 2) * MODEL.scale - 0.25;
        const bell = () => (Math.random() + Math.random() + Math.random()) / 1.5 - 1;
        for (let i = 0; i < count; i++) {
          pos[i * 3] = bell() * 3.4;
          pos[i * 3 + 1] = baseY + (Math.random() - 0.5) * 0.05;
          pos[i * 3 + 2] = bell() * 1.5;
        }
        const g = new THREE.BufferGeometry();
        g.setAttribute('position', new THREE.BufferAttribute(pos, 3));
        scene.add(new THREE.Points(g, new THREE.PointsMaterial({ color: 0xff1a1a, size: 0.008, sizeAttenuation: true })));
      }

      // camera distance from the UNSCALED box, model scaled 3x -> fills the frame
      const maxDim = Math.max(size.x, size.y, size.z);
      const dist = (maxDim / 2) / Math.tan(deg(CAMERA.fov) / 2) * CAMERA.distanceMultiplier;
      camera.position.set(0, size.y * CAMERA.heightFraction, dist);

      const controls = new OrbitControls(camera, renderer.domElement);
      controls.target.set(0, size.y * CAMERA.targetHeightFraction, 0);
      controls.enableDamping = true;
      controls.dampingFactor = 0.03;
      controls.enablePan = false;
      controls.minDistance = controls.maxDistance = dist; // zoom locked, like the reference
      controls.minAzimuthAngle = deg(LIMITS.minAzimuth);
      controls.maxAzimuthAngle = deg(LIMITS.maxAzimuth);
      controls.minPolarAngle = deg(LIMITS.minPolar);
      controls.maxPolarAngle = deg(LIMITS.maxPolar);
      controls.update();

      // orbit the camera around the target by spherical angles, clamped
      const _off = new THREE.Vector3();
      const _sph = new THREE.Spherical();
      function applyOrbit(theta, phiOffset = 0) {
        _off.copy(camera.position).sub(controls.target);
        _sph.setFromVector3(_off);
        _sph.theta = THREE.MathUtils.clamp(theta, controls.minAzimuthAngle, controls.maxAzimuthAngle);
        _sph.phi = THREE.MathUtils.clamp(_sph.phi + phiOffset, controls.minPolarAngle, controls.maxPolarAngle);
        _sph.makeSafe();
        _off.setFromSpherical(_sph);
        camera.position.copy(controls.target).add(_off);
        camera.lookAt(controls.target);
      }
      const azOverride = new URLSearchParams(location.search).get('az'); // debug: ?az=40
      applyOrbit(deg(azOverride !== null ? +azOverride : CAMERA.initialAzimuth), deg(CAMERA.initialPolar));
      controls.update();

      // Cursor-follow: when not dragging, the camera lazily swings toward the pointer.
      let mouseX = 0, userInteracting = false, azimuthOffset = 0;
      let baseAzimuth = controls.getAzimuthalAngle();
      addEventListener('mousemove', (e) => { mouseX = (e.clientX / innerWidth) * 2 - 1; });
      controls.addEventListener('start', () => { userInteracting = true; });
      controls.addEventListener('end', () => {
        userInteracting = false;
        baseAzimuth = controls.getAzimuthalAngle() - azimuthOffset;
      });

      // ---- stats as giant faint text on a cylinder behind the model ----
      function vitalsCylinder(lines) {
        const fontSize = 320;
        const lineSpacing = 0.95;
        const lineHeight = isMobile ? 0.26 : 0.55; // world units per text row
        const radius = 5.0;
        const c = document.createElement('canvas');
        const x = c.getContext('2d');
        const font = `${fontSize}px 'Helvetica Neue', Arial, sans-serif`;
        const ls = `${-0.06 * fontSize}px`;
        x.font = font;
        x.letterSpacing = ls;
        const rowPx = Math.ceil(fontSize * lineSpacing);
        let maxW = 1;
        for (const ln of lines) maxW = Math.max(maxW, x.measureText(ln).width);
        c.width = Math.ceil(maxW) + 26;
        c.height = lines.length * rowPx + Math.ceil(fontSize * 0.5);
        x.font = font;
        x.letterSpacing = ls;
        x.fillStyle = isMobile ? '#222222' : '#111111';
        x.textBaseline = 'top';
        x.textAlign = 'center';
        lines.forEach((ln, i) => x.fillText(ln, c.width / 2, i * rowPx + (rowPx - fontSize) / 2 + fontSize * 0.2));
        const tex = new THREE.CanvasTexture(c);
        tex.minFilter = THREE.LinearFilter;
        tex.magFilter = THREE.LinearFilter;
        tex.anisotropy = 16;
        tex.generateMipmaps = false;
        tex.wrapS = tex.wrapT = THREE.ClampToEdgeWrapping;
        tex.repeat.x = -1; // BackSide mirrors the texture; flip it back
        tex.offset.x = 1;
        const pxPerWorld = rowPx / lineHeight;
        const worldW = c.width / pxPerWorld;
        const worldH = c.height / pxPerWorld;
        const thetaLength = Math.min(worldW / radius, Math.PI * 2);
        const mesh = new THREE.Mesh(
          new THREE.CylinderGeometry(radius, radius, worldH, 96, 1, true, Math.PI - thetaLength / 2, thetaLength),
          new THREE.MeshBasicMaterial({
            map: tex, transparent: true, opacity: 0.85, depthWrite: false, side: THREE.BackSide,
          })
        );
        mesh.renderOrder = -1;
        mesh.position.y = isMobile ? 2.2 : 1.7;
        return mesh;
      }
      // scene.add(vitalsCylinder(STATS)); // texts off for now (was hiding the model)

      renderer.setAnimationLoop(() => {
        if (!userInteracting) {
          const target = mouseX * deg(MODEL.cursorFollow.maxAngle);
          azimuthOffset += (target - azimuthOffset) * MODEL.cursorFollow.smoothing;
          applyOrbit(baseAzimuth + azimuthOffset);
        }
        controls.update();
        renderer.render(scene, camera);
      });

      addEventListener('resize', () => {
        camera.aspect = innerWidth / innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(innerWidth, innerHeight);
      });

      document.getElementById('loading')?.remove();
    </script>
  </body>
</html>
