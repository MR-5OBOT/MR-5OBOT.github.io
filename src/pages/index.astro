---
// v3 home — full-screen three.js point-cloud hero.
// Original implementation inspired by agrshch.com (behavior, not code/assets).
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MR5OBOT</title>
    <meta name="description" content="OHLC trader and token burner." />
    <link rel="icon" type="image/png" href="/assets/profile-2.png" />
    <style>
      html, body { margin: 0; height: 100%; background: #000; overflow: hidden; }
      canvas { display: block; }
      #loading {
        position: fixed; inset: 0; display: grid; place-items: center;
        color: #666; font: 16px 'Helvetica Neue', Arial, sans-serif;
      }
      #info {
        position: fixed; left: 0; right: 0; bottom: 24px; z-index: 2;
        text-align: center; color: #9c9c9c;
        font: 15px/1.55 'Helvetica Neue', Arial, sans-serif;
      }
      #info a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
      #info a:hover { color: #ff2020; }
    </style>
  </head>
  <body>
    <div id="loading">Loading&hellip;</div>

    <div id="info">
      <p>MR5OBOT &nbsp;|&nbsp; OHLC Trader &amp; Token Burner</p>
      <p>
        <a href="https://github.com/MR-5OBOT" target="_blank">GitHub</a> &nbsp;|&nbsp;
        <a href="https://x.com/MR_5OBOT" target="_blank">X</a> &nbsp;|&nbsp;
        <a href="https://t.me/MR_5OBOT" target="_blank">Telegram</a> &nbsp;|&nbsp;
        <a href="https://youtube.com/@mr5obot" target="_blank">YouTube</a> &nbsp;|&nbsp;
        <a href="mailto:yassir7m7@gmail.com">Email</a>
      </p>
    </div>

    <script type="module" is:inline>
      import * as THREE from 'https://esm.sh/three@0.163.0';
      import { OrbitControls } from 'https://esm.sh/three@0.163.0/examples/jsm/controls/OrbitControls.js';

      const isMobile = matchMedia('(max-width: 768px)').matches;

      const STATS = [
        'Pulse: 77',
        'PnL Today: -$4.20',
        'Open Positions: 3',
        'Win Rate (30d): 41%',
        'Tokens Burned: 2.1M',
        'Coffee Level: 86%',
        'Last Sync: just now',
      ];

      const scene = new THREE.Scene();
      scene.background = new THREE.Color(0x000000);

      const camera = new THREE.PerspectiveCamera(55, innerWidth / innerHeight, 0.01, 100);
      camera.position.set(0, 0.5, isMobile ? 8 : 5.4);

      const renderer = new THREE.WebGLRenderer({ antialias: true });
      renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
      renderer.setSize(innerWidth, innerHeight);
      document.body.appendChild(renderer.domElement);

      // Everything lives in one group so the cursor-follow sway rotates the whole scene.
      const group = new THREE.Group();
      scene.add(group);

      // ---- point cloud sampled from the hero illustration's dark pixels ----
      async function sampleImage(url, targetW = 700) {
        const img = await new Promise((res, rej) => {
          const i = new Image();
          i.onload = () => res(i);
          i.onerror = rej;
          i.src = url;
        });
        const c = document.createElement('canvas');
        c.width = targetW;
        c.height = Math.round((img.height / img.width) * targetW);
        const x = c.getContext('2d', { willReadFrequently: true });
        x.drawImage(img, 0, 0, c.width, c.height);
        const d = x.getImageData(0, 0, c.width, c.height).data;
        const pts = []; // triplets: x, y, darkness 0..1
        let minX = 1e9, maxX = -1e9, minY = 1e9, maxY = -1e9;
        for (let py = 0; py < c.height; py++)
          for (let px = 0; px < c.width; px++) {
            const i4 = (py * c.width + px) * 4;
            const lum = (d[i4] + d[i4 + 1] + d[i4 + 2]) / 3;
            const dark = (250 - lum) / 250;
            // quadratic weighting: linework gets far more points than grey fills
            if (d[i4 + 3] > 128 && Math.random() < dark * dark) {
              pts.push(px, py, dark);
              if (px < minX) minX = px;
              if (px > maxX) maxX = px;
              if (py < minY) minY = py;
              if (py > maxY) maxY = py;
            }
          }
        // normalize to the drawing's bounding box so the cloud sits centered
        const w = Math.max(1, maxX - minX), h = Math.max(1, maxY - minY);
        for (let i = 0; i < pts.length; i += 3) {
          pts[i] = (pts[i] - minX) / w;
          pts[i + 1] = (pts[i + 1] - minY) / h;
        }
        return { pts, aspect: h / w };
      }

      function imageCloud({ pts, aspect }, count, width, depth) {
        const n = pts.length / 3;
        const pos = new Float32Array(count * 3);
        const col = new Float32Array(count * 3);
        for (let i = 0; i < count; i++) {
          const j = ((Math.random() * n) | 0) * 3;
          const dark = pts[j + 2];
          pos[i * 3] = (pts[j] - 0.5) * width + (Math.random() - 0.5) * 0.02;
          pos[i * 3 + 1] = (0.5 - pts[j + 1]) * width * aspect + (Math.random() - 0.5) * 0.02;
          // dark linework sits proud of the fills -> relief instead of a flat slab
          pos[i * 3 + 2] = dark * depth + (Math.random() + Math.random() - 1) * depth * 0.3;
          const b = 0.25 + 0.75 * dark; // per-point brightness carries the shading
          col[i * 3] = b;
          col[i * 3 + 1] = b * 0.06;
          col[i * 3 + 2] = b * 0.06;
        }
        const g = new THREE.BufferGeometry();
        g.setAttribute('position', new THREE.BufferAttribute(pos, 3));
        g.setAttribute('color', new THREE.BufferAttribute(col, 3));
        return g;
      }

      const cloudWidth = isMobile ? 3.6 : 5;
      const body = new THREE.Points(
        imageCloud(await sampleImage('/assets/hero.webp'), isMobile ? 50000 : 100000, cloudWidth, 0.5),
        new THREE.PointsMaterial({ size: 0.011, sizeAttenuation: true, vertexColors: true })
      );
      body.position.y = -0.6;
      group.add(body);

      // Ambient scan-noise scatter around the model.
      const scatter = new Float32Array(6000 * 3);
      for (let i = 0; i < scatter.length; i += 3) {
        scatter[i] = (Math.random() - 0.5) * 9;
        scatter[i + 1] = (Math.random() - 0.5) * 5;
        scatter[i + 2] = (Math.random() - 0.5) * 3;
      }
      const noiseGeo = new THREE.BufferGeometry();
      noiseGeo.setAttribute('position', new THREE.BufferAttribute(scatter, 3));
      group.add(
        new THREE.Points(
          noiseGeo,
          new THREE.PointsMaterial({
            color: 0xff0000, size: 0.01, sizeAttenuation: true,
            transparent: true, opacity: 0.3, depthWrite: false,
          })
        )
      );

      // ---- stats text as a plane in world space (skews with the camera) ----
      function statsPanel(lines) {
        const c = document.createElement('canvas');
        const x = c.getContext('2d');
        const fs = 120, lh = fs * 1.25;
        const font = `${fs}px 'Helvetica Neue', Arial, sans-serif`;
        x.font = font;
        c.width = Math.ceil(Math.max(...lines.map((l) => x.measureText(l).width))) + 40;
        c.height = Math.ceil(lh * lines.length + 40);
        x.font = font;
        x.fillStyle = '#9c9c9c';
        x.textAlign = 'center';
        x.textBaseline = 'middle';
        lines.forEach((l, i) => x.fillText(l, c.width / 2, 20 + lh * (i + 0.5)));
        const tex = new THREE.CanvasTexture(c);
        tex.colorSpace = THREE.SRGBColorSpace;
        const h = isMobile ? 2 : 2.5, w = (h * c.width) / c.height;
        return new THREE.Mesh(
          new THREE.PlaneGeometry(w, h),
          new THREE.MeshBasicMaterial({ map: tex, transparent: true, depthWrite: false })
        );
      }
      const stats = statsPanel(STATS);
      stats.position.set(0, 1.15, -0.8);
      group.add(stats);

      // ---- controls: drag-to-orbit, clamped, damped, no zoom/pan ----
      const controls = new OrbitControls(camera, renderer.domElement);
      controls.target.set(0, 0.3, 0);
      controls.enableDamping = true;
      controls.dampingFactor = 0.03;
      controls.enablePan = false;
      controls.enableZoom = false;
      controls.minAzimuthAngle = -Math.PI / 4;
      controls.maxAzimuthAngle = Math.PI / 4;
      controls.minPolarAngle = THREE.MathUtils.degToRad(60);
      controls.maxPolarAngle = THREE.MathUtils.degToRad(110);

      // Cursor-follow: the scene lazily sways toward the pointer.
      let swayTarget = 0;
      addEventListener('pointermove', (e) => {
        if (e.pointerType === 'mouse') swayTarget = (e.clientX / innerWidth - 0.5) * -0.6;
      });

      renderer.setAnimationLoop(() => {
        group.rotation.y += (swayTarget - group.rotation.y) * 0.02;
        controls.update();
        renderer.render(scene, camera);
      });

      addEventListener('resize', () => {
        camera.aspect = innerWidth / innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(innerWidth, innerHeight);
      });

      document.getElementById('loading')?.remove();
    </script>
  </body>
</html>
