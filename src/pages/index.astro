---
// v5 home — textured office GLB (draco + webp, compressed from 133MB to 11MB),
// rendered as-is like the Sketchfab viewer: free drag-orbit, pan, zoom. Nothing else.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MR5OBOT</title>
    <meta name="description" content="OHLC trader and token burner." />
    <link rel="icon" type="image/png" href="/assets/profile-2.png" />
    <style>
      html, body { margin: 0; height: 100%; background: #756769; overflow: hidden; }
      canvas { display: block; }
      #loading {
        position: fixed; inset: 0; display: grid; place-items: center;
        background: #756769; z-index: 10;
        font: 11px/1.4 ui-monospace, 'Cascadia Mono', Menlo, Consolas, monospace;
        transition: opacity 0.6s ease;
      }
      #loading.done { opacity: 0; pointer-events: none; }
      #loading .box { display: grid; gap: 12px; justify-items: center; }
      #loading .name { color: #e8dfe0; letter-spacing: 0.5em; text-indent: 0.5em; font-size: 12px; }
      #load-track { width: 220px; height: 2px; background: rgba(0, 0, 0, 0.25); }
      #load-bar { width: 0%; height: 100%; background: #efe7e8; transition: width 0.2s ease-out; }
      #load-pct { color: #cabfc1; letter-spacing: 0.2em; }
    </style>
  </head>
  <body>
    <div id="loading">
      <div class="box">
        <div class="name">MR5OBOT</div>
        <div id="load-track"><div id="load-bar"></div></div>
        <div id="load-pct">0%</div>
      </div>
    </div>

    <script type="module" is:inline>
      import * as THREE from 'https://esm.sh/three@0.163.0';
      import { OrbitControls } from 'https://esm.sh/three@0.163.0/examples/jsm/controls/OrbitControls.js';
      import { GLTFLoader } from 'https://esm.sh/three@0.163.0/examples/jsm/loaders/GLTFLoader.js';
      import { DRACOLoader } from 'https://esm.sh/three@0.163.0/examples/jsm/loaders/DRACOLoader.js';
      import { RoomEnvironment } from 'https://esm.sh/three@0.163.0/examples/jsm/environments/RoomEnvironment.js';

      const deg = (d) => d * (Math.PI / 180);

      const scene = new THREE.Scene();
      scene.background = new THREE.Color(0x756769);

      const camera = new THREE.PerspectiveCamera(45, innerWidth / innerHeight, 0.01, 100);

      const renderer = new THREE.WebGLRenderer({ antialias: true });
      renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
      renderer.setSize(innerWidth, innerHeight);
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      document.body.appendChild(renderer.domElement);

      // Sketchfab-style mood: dim neutral environment for fill + a warm key light
      // from the upper front-left. URL knobs for tuning without edits:
      //   ?env  fill strength   ?key  key strength   ?exp  exposure
      const P = new URLSearchParams(location.search);
      const knob = (k, d) => +(P.get(k) ?? d);
      renderer.toneMappingExposure = knob('exp', 0.95);
      scene.environment = new THREE.PMREMGenerator(renderer).fromScene(new RoomEnvironment(renderer), 0.04).texture;
      const key = new THREE.DirectionalLight(0xffe9d2, knob('key', 0.9));
      scene.add(key, key.target);

      const loadBar = document.getElementById('load-bar');
      const loadPct = document.getElementById('load-pct');
      function setProgress(p) { // p 0..1
        const pct = Math.min(100, Math.round(p * 100));
        loadBar.style.width = pct + '%';
        loadPct.textContent = pct + '%';
      }

      const draco = new DRACOLoader().setDecoderPath('https://www.gstatic.com/draco/versioned/decoders/1.5.7/');
      const gltf = await new Promise((res, rej) =>
        new GLTFLoader().setDRACOLoader(draco).load(
          '/assets/office.glb',
          res,
          (e) => e.total && setProgress((e.loaded / e.total) * 0.9), // download = 0–90%
          rej
        )
      );
      scene.add(gltf.scene);

      // sharpen textures at grazing angles + dial the env fill down to moody
      const maxAniso = renderer.capabilities.getMaxAnisotropy();
      const envFill = knob('env', 0.55);
      gltf.scene.traverse((o) => {
        if (!o.isMesh) return;
        o.material.envMapIntensity = envFill;
        for (const k of ['map', 'aoMap', 'normalMap', 'roughnessMap', 'metalnessMap', 'emissiveMap'])
          if (o.material[k]) o.material[k].anisotropy = maxAniso;
      });

      // frame the whole scene head-on, camera slightly above center (screenshot view)
      const box = new THREE.Box3().setFromObject(gltf.scene);
      const center = box.getCenter(new THREE.Vector3());
      const size = box.getSize(new THREE.Vector3());
      const maxDim = Math.max(size.x, size.y, size.z);
      const dist = (maxDim / 2) / Math.tan(deg(camera.fov) / 2) * 1.15;

      // key light aims at the scene from upper front-left, like the ref's desk-lamp mood
      key.position.set(center.x - maxDim * 0.8, center.y + maxDim * 1.2, center.z + maxDim * 1.4);
      key.target.position.copy(center);

      const controls = new OrbitControls(camera, renderer.domElement);
      controls.target.copy(center);
      controls.enableDamping = true;
      controls.dampingFactor = 0.06;
      controls.minDistance = maxDim * 0.25;
      controls.maxDistance = maxDim * 4;

      // launch angle: 90° = head-on at the wall (the model's front); ?az= overrides
      const az = deg(knob('az', 90));
      camera.position.set(
        center.x + Math.sin(az) * dist,
        center.y + size.y * 0.08,
        center.z + Math.cos(az) * dist
      );
      controls.update();

      renderer.setAnimationLoop(() => {
        controls.update(); // damping = smooth glide after drag
        renderer.render(scene, camera);
      });

      addEventListener('resize', () => {
        camera.aspect = innerWidth / innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(innerWidth, innerHeight);
      });

      setProgress(1);
      const loading = document.getElementById('loading');
      requestAnimationFrame(() => loading.classList.add('done'));
      loading.addEventListener('transitionend', () => loading.remove(), { once: true });
    </script>
  </body>
</html>
