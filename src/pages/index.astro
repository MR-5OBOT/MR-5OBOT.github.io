      // open UI (fan, cursor) winds down on its own instead of freezing
      addEventListener('pointerout', (e) => { if (!e.relatedTarget) pointer.set(2, 2); });
      addEventListener('blur', () => pointer.set(2, 2));

      // what's under the pointer: the CRT glass (pixel-true via the atlas)
      // or a link icon — fan open/close is handled by fanZone(), not raycast
      const pick = () => {
        raycaster.setFromCamera(pointer, camera);
        // hidden sprites still raycast and would swallow the ray — the faded
        // arrow parks exactly where the bottom icon rises — so skip ghosts
        const hit = raycaster
          .intersectObject(scene, true)
          .find((h) => !h.object.isSprite || (h.object.visible && h.object.material.opacity > 0.1));
        if (!hit) return null;
        if (hit.object === glass ||
            (hit.object === mon && hit.uv && darkAt(hit.uv.x, hit.uv.y) && inGlassArea(hit.point)))
          return { kind: 'glass' };
        if (hit.object.userData?.url) return { kind: 'icon', sprite: hit.object };
        if (hit.object.userData?.drawer !== undefined && atCab && !fly)
          return { kind: 'drawer', idx: hit.object.userData.drawer };
        if (hit.object.userData?.frame && atCab && !fly) return { kind: 'frame' };
        return null;
      };

      // clicks (or taps; a drag is not a click): glass power-cycles the CRT,
      // an icon opens its link
      addEventListener('pointerdown', (e) => {
        trackPointer(e);
        downAt = [e.clientX, e.clientY];
      });
      addEventListener('pointerup', (e) => {
        if (!downAt || Math.hypot(e.clientX - downAt[0], e.clientY - downAt[1]) > 6) return;
        trackPointer(e);
        const p = pick();
        if (p?.kind === 'glass' && !fly && !atCab) {
          lit = 0; // power-cycle flash as the trip starts
          if (cabCam) flyTo(cabCam, cabTgt, true);
          else pendingFly = true; // the 46MB hasn't landed yet — fly on arrival
        }
        else if (p?.kind === 'icon' && fanT > 0.6) window.open(p.sprite.userData.url, '_blank', 'noopener');
        else if (p?.kind === 'drawer' && drawers[p.idx].url && drawers[p.idx].t > 0.5)
          window.open(drawers[p.idx].url, '_blank', 'noopener');
        else if (p?.kind === 'frame' && framedProj?.url) window.open(framedProj.url, '_blank', 'noopener');
      });

      // the CRT is always on — it powers up once as the page appears
      const sst = (x) => x * x * (3 - 2 * x); // smoothstep
      const backOut = (x) => 1 + 2.3 * (x - 1) ** 3 + 1.3 * (x - 1) ** 2; // slight overshoot
      function updateScreen(dt) {
        const p = pick();

        // the hovered drawer slides open; the rest ease shut
        for (let i = 0; i < drawers.length; i++) {
          const d = drawers[i];
          const want = p?.kind === 'drawer' && p.idx === i ? 1 : 0;
          const t2 = d.t + (want - d.t) * (1 - Math.exp(-dt * 7));
          if (Math.abs(t2 - d.t) < 1e-4) continue;
          d.t = t2;
          for (const [m, off] of d.parts) m.position.copy(off).multiplyScalar(sst(d.t));
        }
        // the hovered drawer's project takes the gallery frame — and stays
        // there after the pointer leaves, so you can walk over and click it
        if (p?.kind === 'drawer') {
          const proj = drawers[p.idx].proj;
          if (proj && proj !== framedProj) paintFrame(proj);
        }

        // fan state: boolean with time hysteresis — flicker needs a fast
        // open/close loop, and none exists: opening takes the trigger zone
        // (with the phone actually visible), staying open takes the wide keep
        // zone or an icon underfoot, closing takes 150ms fully outside, and
        // a closing fan can only be re-armed by the trigger itself.
        const z = fanZone();
        const now = performance.now();
        if (fanOpen) {
          if (z.keep || z.trigger || p?.kind === 'icon') zoneLeftAt = 0;
          else if (!zoneLeftAt) zoneLeftAt = now;
          else if (now - zoneLeftAt > 150) { fanOpen = false; zoneLeftAt = 0; }
        } else if (!fly && z.trigger && clearView(hubC.x, hubBox.max.y, hubC.z, hubParts)) fanOpen = true;
        if (fly) fanOpen = false; // the camera sweep drags zones under the parked pointer
        fanT += ((fanOpen ? 1 : 0) - fanT) * (1 - Math.exp(-dt * (fanOpen ? 4.5 : 10))); // unhurried rise, brisk close
        const hot = fanOpen && p?.kind === 'icon' ? p.sprite : null;

        // hover-here arrow: hides while the fan is out, returns when it sinks
        const wantArrow = fanT < 0.15 ? 0.95 : 0;
        arrow.material.opacity += (wantArrow - arrow.material.opacity) * (1 - Math.exp(-dt * 6));
        arrow.visible = arrow.material.opacity > 0.02;
        arrow.position.y = arrowY + Math.sin(performance.now() / 420) * 1.7; // the drop-bounce
        for (const s of fan) {
          if (!s) continue;
          const k = sst(Math.min(Math.max(fanT * 1.45 - s.userData.idx * 0.13, 0), 1));
          s.visible = k > 0.02;
          s.material.opacity = k;
          s.position.y = hubBox.max.y + backOut(k) * s.userData.outY; // pop past, settle
          const base = iconW * (0.75 + 0.25 * k); // grow while rising
          const want = s === hot ? base * 1.22 : base;
          s.scale.x += (want - s.scale.x) * (1 - Math.exp(-dt * 14));
          s.scale.y = s.scale.x;
        }

        // floppy → PROJECTS tag: same state machine, one riser, no click yet
        const fz = flopZone();
        if (flopOpen) {
          if (fz.keep || fz.trigger) flopLeftAt = 0;
          else if (!flopLeftAt) flopLeftAt = now;
          else if (now - flopLeftAt > 150) { flopOpen = false; flopLeftAt = 0; }
        } else if (fz.trigger && clearView(flC.x, flBox.max.y, flC.z, [floppy])) flopOpen = true;
        if (fly) flopOpen = false;
        flopT += ((flopOpen ? 1 : 0) - flopT) * (1 - Math.exp(-dt * (flopOpen ? 4.5 : 10)));
        const tk = sst(flopT);
        tag.visible = tk > 0.02;
        tag.material.opacity = tk;
        tag.position.y = flBox.max.y + backOut(tk) * 7.5;
        const ts = tagW * (0.75 + 0.25 * tk);
        tag.scale.set(ts, ts * (110 / 256), 1);
        const wantArrow2 = flopT < 0.15 ? 0.95 : 0;
        arrow2.material.opacity += (wantArrow2 - arrow2.material.opacity) * (1 - Math.exp(-dt * 6));
        arrow2.visible = arrow2.material.opacity > 0.02;
        arrow2.position.y = arrow2Y + Math.sin(performance.now() / 420 + 2.1) * 1.7; // off-phase from the CD arrow

        // the note's "!": gentle bob + breathing glow, off-phase from both arrows
        bang.position.y = bangY + Math.sin(performance.now() / 520 + 4.2) * 0.7;
        bang.material.opacity = 0.8 + Math.sin(performance.now() / 700) * 0.15;

        // the cabinet's scrawled label drifts on its own slow swell
        if (cabTag) cabTag.position.y = cabTagY + Math.sin(performance.now() / 560 + 1.3) * 2.4;
        // the gallery frame floats on its own, slower and slighter
        if (frameObj) frameObj.position.y = frameBaseY + Math.sin(performance.now() / 640 + 3.3) * 1.2;

        const wantPointer = p?.kind === 'glass' || (p?.kind === 'drawer' && !!drawers[p.idx].url)
          || (p?.kind === 'frame' && !!framedProj?.url) || !!hot;
        if (wantPointer !== pointerPrev) {
          pointerPrev = wantPointer;
          renderer.domElement.style.cursor = wantPointer ? 'pointer' : '';
        }

        lit += (1 - lit) * (1 - Math.exp(-dt * 8)); // framerate-independent ease to on
        glass.visible = lit > 0.02;
        if (!glass.visible) return;
        glass.material.opacity = Math.min(1, lit * 2.5);
        const cursorOn = Math.floor(performance.now() / 530) % 2 === 0;
        const squash = Math.min(lit * 1.06, 1); // picture expands as the tube wakes
        if (cursorOn !== cursorPrev || Math.abs(squash - squashPrev) > 0.004) {
          cursorPrev = cursorOn;
          squashPrev = squash;
          drawScreen(cursorOn, squash);
        }
      }
      window.__dbg = { camera, glass, mon, anchor, scene, renderer, THREE, fan, arrow, arrow2, tag, litNow: () => lit, fanNow: () => fanT, flopNow: () => flopT, flyNow: () => !!fly, atCab: () => atCab, cabView: () => cabCam, drawers: () => drawers, frameNow: () => framedProj?.title ?? null, frameObj: () => frameObj, goHome }; // headless-test handle

      let tPrev = performance.now();
      renderer.setAnimationLoop((t) => {
        const dt = Math.min((t - tPrev) / 1000, 0.1);
        tPrev = t;
        if (fly) {
          fly.t = Math.min(1, fly.t + dt / 2.6);
          const k = fly.t ** 3 * (fly.t * (fly.t * 6 - 15) + 10); // smootherstep
          const a = 1 - k;
          camera.position.copy(fly.p0).multiplyScalar(a * a)
            .addScaledVector(fly.p1, 2 * a * k)
            .addScaledVector(fly.p2, k * k);
          controls.target.lerpVectors(fly.t0, fly.t1, k);
          camera.lookAt(controls.target);
          if (fly.t >= 1) {
            fly = null;
            controls.enabled = true;
            if (atCab) backBtn.classList.add('on');
            else cabRoot.visible = false; // landed home — vanish behind our back
          }
        } else controls.update(); // damping = smooth glide after drag
        updateScreen(dt);
        renderer.render(scene, camera);
      });

      addEventListener('resize', () => {
        camera.aspect = innerWidth / innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(innerWidth, innerHeight);
      });

      setProgress(1);
      const loading = document.getElementById('loading');
      requestAnimationFrame(() => loading.classList.add('done'));
      loading.addEventListener('transitionend', () => loading.remove(), { once: true });
    </script>
  </body>
</html>
