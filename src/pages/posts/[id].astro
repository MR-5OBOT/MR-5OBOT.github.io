---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const dateStr = post.data.date
  .toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
  .toUpperCase();
---

<Base title={`MR5OBOT // ${post.data.title}`} description={post.data.description} active="knowledge" transparentNav vig={0.4} bodyClass="post">
  <!-- the post rendered as an 85% window frame: no nav, no socials, X to close, blurred heatmap around it -->
  <div class="frame">
    <p class="meta bar">{dateStr} · {post.data.read} · {post.data.tag}</p>
    <h1 class="bar-title">{post.data.title}</h1>
    <a class="close" href="/knowledge" aria-label="Close">✕</a>
    <div class="scroller">
      <article class="post">
        <div class="prose"><Content /></div>
        <a class="back" href="/knowledge">← back to leaks</a>
      </article>
    </div>
    <div class="scrollbar v"><canvas class="nav-thumb"></canvas></div>
  </div>

  <style is:global>
    html, body { height: 100%; overflow: hidden; }     /* the frame owns the scroll */
    body.post {
      background: #000 radial-gradient(ellipse 700px 320px at 50% 45%, rgba(177,140,255,.07), transparent 70%) fixed;
    }
    body.post .nav, body.post .social { display: none; }  /* frame view: chrome off */
    body.post #bg { filter: blur(6px); }                   /* heatmap peeks around the frame, blurred */

    /* the window frame — 90% of the screen, wearing the same hand-drawn frame as the nav */
    .frame {
      position: fixed; inset: 0; margin: auto; width: 90vw; height: 90vh;
      background: transparent;                            /* fill is baked into the frame SVG */
      border: 18px solid transparent;
      border-image: url(/nav-frame.svg) 40 fill stretch;
      z-index: 10;
      filter: drop-shadow(0 0 40px rgba(0,0,0,.85));
      animation: frame-in .5s cubic-bezier(.16,1,.3,1);   /* window settles in: scale up + rise */
    }
    @keyframes frame-in {
      from { transform: scale(.96) translateY(14px); opacity: 0; }
    }
    @media (prefers-reduced-motion: reduce) { .frame { animation: none; } }
    /* meta as the frame's frozen title row: the scroller starts BELOW it, so content clips there and can never overlap */
    .frame .meta.bar {
      position: absolute; top: 0; left: 0; right: 0; height: 54px; z-index: 3;
      display: flex; align-items: center; justify-content: flex-start;
      padding: 0 0 0 20px;
      margin: 0; font-family: "Space Mono", monospace; font-size: 14px;
      letter-spacing: 1.5px; color: #b18cff; white-space: nowrap;
      background: #101010;                                /* solid fill, same as the frame SVG — nothing shows through */
      border-bottom: 1px solid #2a2a2a;                   /* the frozen-row divider */
    }
    /* post title, centred in the title row like the nav wordmark */
    .frame .bar-title {
      position: absolute; top: 0; left: 50%; transform: translateX(-50%); height: 54px; z-index: 4;
      display: flex; align-items: center;
      margin: 0; font-size: 22px; font-weight: 700; letter-spacing: -.5px; color: #f5f5f5;
      white-space: nowrap; max-width: 46%; overflow: hidden; text-overflow: ellipsis;
    }
    .frame .close {
      position: absolute; top: 0; right: 12px; height: 54px; z-index: 4;
      display: flex; align-items: center;                 /* vertically centred in the title row */
      font-size: 26px; line-height: 1; padding: 0 8px; color: #ddd; text-decoration: none;
      transition: color .2s, transform .2s;
    }
    .frame .close:hover { color: #b18cff; transform: scale(1.15); }
    .frame .scroller { position: absolute; top: 55px; right: 0; bottom: 0; left: 0; overflow-y: auto; scrollbar-width: none; }
    .frame .scroller::-webkit-scrollbar { display: none; }

    /* pixel rail, inside the frame's right edge */
    .scrollbar.v { position: absolute; top: 64px; bottom: 20px; right: 6px; width: 20px; z-index: 2; pointer-events: none; }
    .scrollbar.v::before {
      content: ""; position: absolute; left: 50%; top: 0; bottom: 0;
      width: 2px; transform: translateX(-50%); background: rgba(255,255,255,.06);
    }
    .scrollbar.v .nav-thumb {
      position: absolute; top: 0; left: 50%; width: 16px; height: 150px; transform: translateX(-50%);
      display: block; filter: blur(1.5px) drop-shadow(0 0 8px rgba(58,31,112,.45));
    }

    article.post { max-width: 860px; margin: 0 auto; padding: 40px 44px 90px; color: #c8c8c8; }
    .post .prose { font-size: 17px; line-height: 1.75; }
    .post .prose img { max-width: 100%; height: auto; border: 1.5px solid #2a2a2a; margin: 1.4em 0; }
    .post .prose a { color: #b18cff; }
    .post .prose h2 { color: #f2f2f2; font-size: 24px; letter-spacing: -.5px; margin: 1.8em 0 .6em; }
    .post .prose strong { color: #e8e8e8; }
    .post .prose code { font-family: "Space Mono", monospace; font-size: 15px; }
    .post .prose :not(pre) > code { background: #161616; border: 1px solid #262626; border-radius: 3px; padding: 1px 6px; color: #cbb7f5; }
    .post .prose pre { border: 1.5px solid #2a2a2a; padding: 16px 18px; overflow-x: auto; margin: 1.4em 0; }
    .post .prose blockquote { border-left: 3px solid #b18cff; margin: 1.4em 0; padding: 2px 0 2px 18px; color: #b0b0b0; }
    .post .prose table { border-collapse: collapse; margin: 1.4em 0; width: 100%; }
    .post .prose th { font-family: "Space Mono", monospace; font-size: 13px; letter-spacing: 1.5px; text-transform: uppercase; color: #b18cff; text-align: left; }
    .post .prose th, .post .prose td { border: 1px solid #2a2a2a; padding: 8px 14px; }
    .post .back { display: inline-block; margin-top: 48px; font-family: "Space Mono", monospace; color: #b18cff; text-decoration: none; letter-spacing: 1px; }
    .post .back:hover { color: #cbb7f5; text-decoration: underline; }

    @media (max-width: 700px) {
      .frame { width: 96vw; height: 94vh; }
      article.post { padding: 44px 20px 70px; }
    }
  </style>

  <script>
    function initPostFrame() {
      const frame = document.querySelector<HTMLElement>('.frame');
      if (!frame) return;
      const scroller = frame.querySelector<HTMLElement>('.scroller')!;
      const rail = frame.querySelector<HTMLElement>('.scrollbar.v')!;
      const thumb = rail.querySelector('canvas')!;
      const tctx = thumb.getContext('2d')!;
      const close = frame.querySelector<HTMLAnchorElement>('.close')!;
      const ac = new AbortController(), { signal } = ac;
      document.addEventListener('astro:before-swap', () => ac.abort(), { once: true });

      function pix() {                                   // same big-pixel purple bar as the carousels
        const w = thumb.width, h = thumb.height, C = 6;
        tctx.clearRect(0, 0, w, h);
        tctx.fillStyle = '#3a1f72';
        for (let y = 0; y < h; y += C) for (let x = 0; x < w; x += C) {
          const fa = Math.min(1, (1 - Math.abs(y / h - 0.5) * 2) * 2.5);
          const fb = 0.6 + 0.4 * (1 - Math.abs(x / w - 0.5) * 2);
          tctx.globalAlpha = (0.55 + Math.random() * 0.35) * fa * fb;
          tctx.fillRect(x, y, C - 1, C - 1);
        }
      }
      function size() {
        const r = thumb.getBoundingClientRect();
        thumb.width = Math.max(1, r.width | 0); thumb.height = Math.max(1, r.height | 0);
        pix();
      }
      function move() {                                  // thumb tracks the frame's inner scroll
        const max = scroller.scrollHeight - scroller.clientHeight;
        const f = max > 0 ? scroller.scrollTop / max : 0;
        thumb.style.top = f * (rail.clientHeight - thumb.offsetHeight) + 'px';
      }
      scroller.addEventListener('scroll', move, { passive: true, signal });
      addEventListener('resize', () => { size(); move(); }, { signal });
      size(); move();

      /* Esc or a click on the blurred backdrop closes the frame */
      addEventListener('keydown', (e) => { if (e.key === 'Escape') close.click(); }, { signal });
      document.addEventListener('click', (e) => {
        if (!frame.contains(e.target as Node)) close.click();
      }, { signal });
    }
    document.addEventListener('astro:page-load', initPostFrame);
  </script>
</Base>
