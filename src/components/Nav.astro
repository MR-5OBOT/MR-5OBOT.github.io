---
const letters = [...'MR5OBOT'];
---

<a class="nav" href="/" aria-label="MR5OBOT home">
  <span class="logo-name" aria-hidden="true">
    {letters.map((letter, i) => <span style={`--i:${i}`}>{letter}</span>)}
  </span>
</a>

<style>
  .nav {
    position: fixed;
    top: 32px;
    left: 50%;
    z-index: 50;
    color: #fff;
    text-decoration: none;
    transform: translateX(-50%);
    filter: url(#pixelate);
  }
  .nav:hover { color: #a280ea; }
  .logo-name {
    display: flex;
    align-items: baseline;
    font: 700 clamp(40px, 5vw, 72px) 'Space Mono', monospace;
    letter-spacing: .08em;
    white-space: nowrap;
  }
  .logo-name > span {
    max-width: 0;
    overflow: hidden;
    animation: type .01s steps(1) calc(.3s + var(--i) * .12s) forwards;
  }
  .logo-name::after {
    content: '';
    width: .12em;
    height: .8em;
    margin-left: .08em;
    background: #a280ea;
    animation: blink .7s step-end infinite;
  }
  @keyframes type { to { max-width: 2em; } }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .logo-name > span { max-width: 2em; animation: none; }
    .logo-name::after { display: none; }
  }
  @media (max-width: 560px) {
    .nav { top: 20px; }
    .logo-name { font-size: 36px; }
  }
</style>
